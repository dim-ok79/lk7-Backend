                      ,p_action     IN VARCHAR2
                      ,p_ip_address IN VARCHAR2
                      ,p_browser    IN VARCHAR2
                      ,p_os         IN VARCHAR2
                       --                      ,p_patient_id IN OUT NUMBER
                      ,p_patient_id IN NUMBER
                      ,p_success    IN NUMBER
                      ,p_url        IN VARCHAR2
                      ,p_rc         IN OUT pkg_global.ref_cursor_type);

