
CREATE OR REPLACE PACKAGE BODY pkg_web_account_unique_7 IS

  PROCEDURE set_context_userid AS
    l_result VARCHAR2(256);
  BEGIN
    SELECT keyid
      INTO l_result
      FROM man
     WHERE man.code = 'WEBREC_PAWEB'
       AND rownum = 1;
    solution_med.gsp_set_context('USER_ID', l_result);
  EXCEPTION
    WHEN no_data_found THEN
      l_result := 1;
      solution_med.gsp_set_context('USER_ID', l_result);
    WHEN OTHERS THEN
      l_result := 1;
      solution_med.gsp_set_context('USER_ID', l_result);
  END set_context_userid;

  FUNCTION get_template_html(p_code IN VARCHAR2) RETURN CLOB IS
    res CLOB;
  BEGIN
    SELECT t.text
      INTO res
      FROM inetuser.WS_HTML_TEMPLATE_TEXT t
     WHERE t.code = p_code;
    RETURN res;
  EXCEPTION
    WHEN OTHERS THEN
      RETURN NULL;
  END get_template_html;

  PROCEDURE get_param(p_code IN VARCHAR2
                     ,p_rc   IN OUT pkg_global.ref_cursor_type) AS
    l_param_text param.text%TYPE;
  BEGIN
    SELECT MAX(p.text)
      INTO l_param_text
      FROM solution_med.param p
     WHERE p.code = p_code;

    IF l_param_text = 'QUERY' THEN
      OPEN p_rc FOR
        SELECT 0 AS ptype -- текст
              ,get_template_html(p_code) AS pval
          FROM dual
         WHERE p_code = p_code;
    ELSE
      OPEN p_rc FOR
        SELECT ptype
              ,decode(to_number(ptype), 0, text, 1, codei, 2, codei, 3, codef) AS pval
          FROM solution_med.param
         WHERE code = p_code
           AND rownum = 1;
    END IF;
  END get_param;

  PROCEDURE server_log(p_session_id IN VARCHAR2
                      ,p_action     IN VARCHAR2
                      ,p_ip_address IN VARCHAR2
                      ,p_browser    IN VARCHAR2
                      ,p_os         IN VARCHAR2
--                      ,p_patient_id IN OUT NUMBER
                      ,p_patient_id IN NUMBER
                      ,p_success    IN NUMBER
                      ,p_url        IN VARCHAR2
                      ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
    l_log_level  NUMBER := 0;
    l_rnumb_id   NUMBER;
    l_text       VARCHAR(4000) := '';
    l_doc_fio    VARCHAR2(256);
    l_dat_rnumb  VARCHAR2(256);
    l_find_str   VARCHAR2(256);
    l_find_token VARCHAR2(256);
    l_patient_id NUMBER;
    p_rc1         pkg_global.ref_cursor_type;
  BEGIN
    IF p_patient_id IS NOT NULL THEN
         l_patient_id := p_patient_id;
    END IF;

    IF (p_success != 1) THEN
      l_log_level := 2;
    END IF;

    IF p_action = 'ESIAREG' THEN
      l_text := 'Регистрация через Гос-услуги';
    END IF;

    IF p_action = 'COMMISSION' THEN
      l_text := 'Заявка на отборочную комисию';
    END IF;

    IF p_action = 'ESIAREGLOGIN' THEN
      l_text := 'Создание пароля';
    END IF;

    IF p_action = 'AUTHESIA' THEN
      l_text := 'Вход через Гос-услуги';
    END IF;

    IF p_action = 'SENDPASSTOEMAIL' THEN
      l_text := 'Восстановление пароля через почту';
    ELSE
      IF p_action = 'CHANGEPASSTOEMAIL' THEN
        IF p_success = 1 THEN
          l_text       := 'Смена пароля, восстановление.';
          l_find_str   := '/changepasswd/token/';
          l_find_token := substr(p_url, instr(p_url, l_find_str, 1) + length(l_find_str));
          SELECT MAX(patient_id)
            INTO l_patient_id
            FROM inetuser.wa_token
           WHERE token = TRIM(l_find_token);
        ELSE
          l_text := 'Попытка смены пароля, восстановление.';
        END IF;
    ELSE
        IF p_action = 'AUTH' THEN
          l_text := 'Авторизация';
          IF l_patient_id IS NOT NULL THEN
            /*отправка почтового почтового сообщения об успешной авторизации пациента*/
            send_email_auth_success(p_session_id => p_session_id
                                                 ,p_action     => p_action
                                                 ,p_ip_address => p_ip_address
                                                 ,p_browser    => p_browser
                                                 ,p_os         => p_os
                                                 ,p_patient_id => l_patient_id
                                                 ,p_success    => p_success
                                                 ,p_url        => p_url
                                                 ,p_rc         => p_rc1);
          ELSE
            l_text := l_text || ' (Неправильно указан логин/пароль)';
          END IF;
        ELSE
          IF p_action = 'AUTHPHONE' THEN
            IF nvl(p_success, 0) = 1 THEN
              l_text := 'Авторизация через телефон';
            ELSIF nvl(p_success, 0) = 0 THEN
              l_text := 'Авторизация по телефону не удалось';
            END IF;
          ELSE
          IF p_action = 'CHANGE_PWD' THEN
            IF nvl(p_success, 0) = 1 THEN
              l_text := 'Вы сменили пароль';
            ELSIF nvl(p_success, 0) = 0 THEN
              l_text := 'Сменить пароль не удалось';
            END IF;
          ELSE
            IF p_action = 'APPOINTMENT' THEN
              IF p_success = 1 THEN
                SELECT to_number(regexp_substr(p_url, '[0-9]+'))
                  INTO l_rnumb_id
                  FROM dual;
                IF nvl(l_rnumb_id, 0) != 0 THEN
                  SELECT fn_doc_short_name_by_ddid(rn.docdepid)
                        ,to_char(rn.dat, 'dd.mm.yyyy hh24:mi')
                    INTO l_doc_fio
                        ,l_dat_rnumb
                    FROM solution_med.rnumb rn
                   WHERE rn.keyid = l_rnumb_id;
                END IF;
                l_text := 'Вы записались к врачу ' || l_doc_fio || ' на ' || l_dat_rnumb;
              ELSE
                l_text := 'Запись на прием не получилась';
              END IF;
            ELSE
              IF p_action = 'CANSELLAPPOINTMENT' THEN

                SELECT to_number(regexp_substr(p_url, '[0-9]+'))
                  INTO l_rnumb_id
                  FROM dual;
                IF nvl(l_rnumb_id, 0) != 0 THEN
                  SELECT fn_doc_short_name_by_ddid(rn.docdepid)
                        ,to_char(rn.dat, 'dd.mm.yyyy hh24:mi')
                    INTO l_doc_fio
                        ,l_dat_rnumb
                    FROM solution_med.rnumb rn
                   WHERE rn.keyid = l_rnumb_id;
/*                  l_text := 'Отмена записи на прием к ' || l_doc_fio || ' на ' || l_dat_rnumb ||
                            ' была выполнена самим пациентом ';
*/
                    l_text := 'Вы отменили запись на прием к врачу ' || l_doc_fio || ' на ' || l_dat_rnumb;
                ELSE
                  l_text := 'Отмена записи на прием была выполнена';
                END IF;

              END IF; -- CANSELLAPPOINTMENT
            END IF; -- APPOINTMENT
            END IF; -- AUTHPHONE
          END IF; ---1 CHANGE_PWD
        END IF; -- AUTH
      END IF;
    END IF;

    -- в случае успешной записи
    /*
      if p_action = 'APPOINTMENT' and p_success=1 then
        SELECT to_number(REGEXP_SUBSTR(p_url, '[0-9]+')) into l_rnumb_id from dual;
        l_text := 'Номерок '||to_char(l_rnumb_id);
      end if;
    */
    IF (length(l_text) > 1) THEN
      INSERT INTO inetuser.wa_log
        (id
        ,applic
        ,session_id
        ,dat
        ,action
        ,text
        ,ip_address
        ,browser
        ,os
        ,patient_id
        ,log_level
        ,success)
      VALUES
        (pkg_global.get_next_id('INETUSER', 'WA_LOG')
        ,applic_name
        ,p_session_id
        ,SYSDATE
        ,p_action
        ,l_text
        ,p_ip_address
        ,p_browser
        ,p_os
        ,l_patient_id
        ,l_log_level
        ,p_success);

    END IF;
    OPEN p_rc FOR
      SELECT 0 AS err_code
            ,'' AS err_text
        FROM dual;

  END server_log;

  PROCEDURE login(p_login IN VARCHAR2
                 ,p_pass  IN VARCHAR2
                 ,p_rc    IN OUT pkg_global.ref_cursor_type) AS
    l_patient_id patient.keyid%TYPE;
    l_email      VARCHAR2(1000);
    l_result_rec pkg_global.result_rtype;
  BEGIN

    set_context_userid;

    SELECT MAX(patient_id)
      INTO l_patient_id
      FROM inetuser.patient_logon pl
     WHERE pl.status = 1
       AND pl.logon_name = p_login
       AND pl.pass = p_pass;

    IF l_patient_id IS NULL THEN
      l_result_rec.error_code := pkg_global.err_crit;
      l_result_rec.error_text := 'Неверный логин или пароль!';
    ELSIF nvl(p_admin.fn_get_param_value_number('506741'), 0) = 1 THEN
      SELECT regexp_substr(note, '^[A-Za-z0-9]+[A-Za-z0-9._-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,4}$')
        INTO l_email
        FROM patient p
       WHERE p.keyid = l_patient_id;

      IF l_email IS NULL THEN
        l_result_rec.error_code := pkg_global.err_crit;
        l_result_rec.error_text := 'Не указан почтовый адрес!';
      END IF;
    END IF;

    OPEN p_rc FOR
      SELECT l_patient_id            AS patient_id
            ,l_result_rec.error_code AS err_code
            ,l_result_rec.error_text AS err_text
        FROM dual;
  END login;

  PROCEDURE patient_info(p_patient_id IN NUMBER
                        ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    OPEN p_rc FOR
      SELECT p.num -- Номер карты в ЛПУ
            ,g_make_first_upper(p.lastname) AS lastname -- Фамилия
            ,g_make_first_upper(p.firstname) AS firstname -- Имя
            ,g_make_first_upper(p.secondname) AS secondname -- Отчество
--            ,p.birthdate -- Дата рождения
--            ,to_char(p.birthdate, 'dd.mm.yyyy HH24:MI') AS birthdateStr
            ,to_char(p.birthdate, 'dd.mm.yyyy') AS birthdateStr
            ,p.phone -- Номер телефона
            ,p.cellular -- Номер сотового телефона
            ,p.note AS email -- e-mail/факс
            ,p.snils   -- снилс ИНН
            ,gsp_get_pat_address(p.keyid, 2) AS address_proj -- Адрес проживания
            ,gsp_get_pat_address(p.keyid, 1) AS address_proj_f -- Адрес Фактический 
            ,(SELECT count(PL.ID) FROM inetuser.patient_logon pl
                 WHERE pl.status = 1
                       AND pl.patient_id = p_patient_id
                       AND pl.logon_name IS NOT NULL
                       AND pl.pass  IS NOT NULL)  AS count_login
             ,p.sex
             , gsp_get_age_full_years(p.birthdate, SYSDATE) AS age -- Получаем возраст пациента
        FROM patient p
       WHERE p.keyid = p_patient_id;
  END patient_info;

  PROCEDURE send_email_auth_success(p_session_id IN VARCHAR2
                                   ,p_action     IN VARCHAR2
                                   ,p_ip_address IN VARCHAR2
                                   ,p_browser    IN VARCHAR2
                                   ,p_os         IN VARCHAR2
                                   ,p_patient_id IN OUT NUMBER
                                   ,p_success    IN NUMBER
                                   ,p_url        IN VARCHAR2
                                   ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
    l_lastname      VARCHAR2(100);
    l_firstname     VARCHAR2(100);
    l_secondname    VARCHAR2(100);
    l_fio           VARCHAR2(100);
    l_email_patient VARCHAR2(100);
    l_logon_name    VARCHAR2(100);
    l_to            VARCHAR2(512);
    l_subject       VARCHAR2(512);
    l_content_html  CLOB;

  BEGIN

    -- Получаем данные по пациенту
    SELECT g_make_first_upper(p.lastname) AS lastname -- Фамилия
          ,g_make_first_upper(p.firstname) AS firstname -- Имя
          ,g_make_first_upper(p.secondname) AS secondname -- Отчество
          ,p_pat.fio(p.keyid, 1) fio
          ,p.note -- e-mail/факс
          ,pa.logon_name
      INTO l_lastname
          ,l_firstname
          ,l_secondname
          ,l_fio
          ,l_email_patient
          ,l_logon_name
      FROM patient                p
          ,inetuser.patient_logon pa
     WHERE p.keyid = p_patient_id
       AND pa.patient_id = p.keyid;

    IF length(l_email_patient) > 3 THEN
      IF p_success = 1 THEN

        SELECT l_lastname || ' ' || l_firstname || ' <' || l_email_patient || '>'
              ,t.subject
              ,REPLACE(
               REPLACE(
               REPLACE(
               REPLACE(
               REPLACE(
               REPLACE(
               REPLACE(
               REPLACE(t.text, '[p_FIO]', l_lastname || ' ' || l_firstname)
                             , '[p_DATE_TIME]', to_char(SYSDATE, 'dd.mm.yyyy') || ' в ' || to_char(SYSDATE, 'hh24:mi'))
                             , '[p_IP_ADDRESS]', p_ip_address)
                             , '[p_BROWSER]', p_browser)
                             , '[p_OS]', p_os)
                             , '[p_EMAIL_URL_LOGO]', c_email_url_logo)
                             , '[p_EMAIL_INFO]', c_email_info)
                             , '[p_EMAIL_PHONE]', c_email_phone)
          INTO l_to
              ,l_subject
              ,l_content_html
          FROM inetuser.WS_HTML_TEMPLATE_TEXT t
         WHERE t.code = 'WEB_LK_auth_success';

        pkg_ws_informer.send_email_html_sync(p_guid         => pkg_ws_informer.get_guid()
                                            ,p_address_to   => l_to
                                            ,p_subject      => l_subject
                                            ,p_content_html => l_content_html
                                            ,p_rc           => p_rc);
      END IF;
    ELSE
      OPEN p_rc FOR
        SELECT pkg_global.err_warn AS ERROR_CODE
              ,'Не найдена электронная почта пользователя' AS error_text
          FROM dual;
    END IF;
  END send_email_auth_success;

  PROCEDURE get_patient_ext(p_patient_id     IN NUMBER
                           ,p_rc             IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    /* Весь список доступов:
       WEB_LK_MODULES = 'to-doctor,h-doctor,laboratory,history,services,payments,abonements,controls'
    */
      OPEN p_rc FOR
        SELECT 'WEB_LK_MODULES0' AS name,
            'to-doctor,h-doctor,history,services' AS value
          FROM dual;
/* Так добавить другие параметры
          UNION ALL
        SELECT 'WEB_LK_TEST' AS name,
            'werwrwrwerew' AS value
          FROM dual;
*/
  END get_patient_ext;

/* Получить название ЛПУ */
  FUNCTION fn_get_name_lpu(p_id      IN NUMBER) RETURN VARCHAR2 IS
    l_result_value VARCHAR2(100);
  BEGIN
    l_result_value := '';
    CASE (p_id)
    WHEN 1 THEN l_result_value := 'Центральная поликлиника';
    WHEN 3 THEN l_result_value := 'Валдайский многопрофильный медицинский центр';
    WHEN 5 THEN l_result_value := 'Поликлиника, филиал №2 (научно-лечебный центр)';
    WHEN 6 THEN l_result_value := 'Центр промышленной и морской медицины';
    WHEN 7 THEN l_result_value := 'Поликлиника №1';
    WHEN 8 THEN l_result_value := 'Поликлиника №3';
    WHEN 9 THEN l_result_value := 'Поликлиника №6';
    ELSE l_result_value := '';
    END CASE;
    return l_result_value;
  END fn_get_name_lpu;

/* Получить адрес ЛПУ */
  FUNCTION fn_get_addres_lpu(p_id      IN NUMBER) RETURN VARCHAR2 IS
    l_result_value VARCHAR2(100);
  BEGIN
    l_result_value := '';
    CASE (p_id)
    WHEN 1 THEN l_result_value := 'Санкт-Петербург, пр. Луначарского, д.49';
    WHEN 3 THEN l_result_value := 'Новгородская область, г.Валдай, ул. Песчаная 1Б';
    WHEN 5 THEN l_result_value := 'Санкт-Петербург, ул. Красина, д.4';
    WHEN 6 THEN l_result_value := 'Санкт-Петербург, пр. Ленинский, д. 101, корп. 5.';
    ELSE l_result_value := '';
    END CASE;
    return l_result_value;
  END fn_get_addres_lpu;

  FUNCTION fn_get_orderby_lpu(p_id      IN NUMBER) RETURN NUMBER IS
    l_result_value NUMBER;
  BEGIN
    l_result_value := 0;
    CASE (p_id)
    WHEN 1 THEN l_result_value := 1;
    WHEN 3 THEN l_result_value := 4;
    WHEN 5 THEN l_result_value := 2;
    WHEN 6 THEN l_result_value := 3;
    ELSE l_result_value := 10;
    END CASE;
    return l_result_value;
  END fn_get_orderby_lpu;

  /**
  * Получить список подразделений
  */

  PROCEDURE get_lpu_list(p_patient_id  IN NUMBER, p_rc       IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    OPEN p_rc FOR
      select v.* from (
      select l.keyid as id, fn_get_orderby_lpu(l.keyid)as orderBY, fn_get_name_lpu(l.keyid) as name, fn_get_addres_lpu(l.keyid) as addres, 0 as isPatient
      from solution_med.lpu l
      where l.keyid not in (select l.keyid
                           from patattach pa, lpu l
                           where pa.patientid = p_patient_id
                           and l.keyid = pa.lpuid)
      and l.keyid not in (7,8,9,3)
      UNION all
      -- Список прикрепленных ЛПУ Пациента
      select l.keyid as id,  fn_get_orderby_lpu(l.keyid)as orderBY, fn_get_name_lpu(l.keyid) as name, fn_get_addres_lpu(l.keyid) as addres, 1 as isPatient
      from solution_med.lpu l
      where l.keyid in (select l.keyid
                       from patattach pa, lpu l
                       where pa.patientid = p_patient_id
                       and l.keyid = pa.lpuid)
      or l.keyid in ( -- Поиск по шифрам
        select vv.lpu from (
            select count(a.keyid) as col, 8 as lpu
            FROM agr a
                ,agrpat d
            WHERE a.keyid = d.agrid
              AND d.patientid = p_patient_id
              AND a.typ in ('1.01', '8.47', '27.91', '37.31') -- 27.10.4
              AND (a.typ like  '1.01%' or a.typ like  '8.47%' or a.typ like  '27.91%'or a.typ like  '37.31%')
        union all
            select count(a.keyid) as col, 7 as lpu
            FROM agr a
                ,agrpat d
            WHERE a.keyid = d.agrid
              AND d.patientid = p_patient_id
              AND a.typ in ('1.02', '1.16', '37.11', '8.236')
              AND (a.typ like '1.02%' or a.typ like  '1.16%' or a.typ like  '37.11%'or a.typ like  '8.236%')
        union all
            select count(a.keyid) as col, 9 as lpu
            FROM agr a
                ,agrpat d
            WHERE a.keyid = d.agrid
              AND d.patientid = p_patient_id
              AND (a.typ like '37.61%' or a.typ like  '5.11%' or a.typ like  '7.301%')
        union all
            select count(a.keyid) as col, 3 as lpu -- Валдай
            FROM agr a
                ,agrpat d
            WHERE a.keyid = d.agrid
              AND d.patientid = p_patient_id
              AND (a.typ like '9.53%.7')
        union all
            select count(a.keyid) as col, 1 as lpu -- Центральная пол
            FROM agr a
                ,agrpat d
            WHERE a.keyid = d.agrid
              AND d.patientid = p_patient_id
              AND (a.typ like '9.78%.71')
        )vv
        where vv.col >0
      )
      ) v
      Order by v.orderBY;
  END get_lpu_list;

  /* Получение списка подписанных договоров по пациенту */
  PROCEDURE contract_get_list_by_patient(p_patient_id IN NUMBER
                                        ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    OPEN p_rc FOR
      SELECT d.id
            ,to_char(d.createdate, 'dd.mm.yyyy') dat
            ,rl.text
        FROM solution_data.documents    d
            ,solution_form.report_list  rl
            ,inetuser.web_form_contract w
       WHERE d.tag = 7
         AND d.patient_id = p_patient_id
         AND d.type_id = fn_get_lu_id_by_tag_code(327, 798)
         AND w.report_list_id = rl.keyid
         AND w.patient_id = d.patient_id
         AND w.documents_id = d.id
--         AND 1=0
       ORDER BY d.name;
  END contract_get_list_by_patient;

  /* Получение списка договоров на подпись при авторизации */
  PROCEDURE contract_get_list_for_sig(p_patient_id IN NUMBER
                                 ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    OPEN p_rc FOR
      SELECT tfe.template_file_id AS template_id
            ,rl.text              AS template_name
        FROM solution_form.report_list       rl
            ,solution_form.report_group      g
            ,solution_data.template_file_use tfe
       WHERE rl.report_group_id = g.keyid
         AND rl.status = 1
         AND g.code = 'WEB_ACCOUNT_NODE'
         AND tfe.link_id = rl.keyid
         AND tfe.tag = 1
         AND NOT EXISTS (SELECT NULL
                           FROM solution_data.documents    d
                               ,inetuser.web_form_contract w
                          WHERE d.tag = 7
                            AND d.patient_id = p_patient_id
                            AND w.report_list_id = rl.keyid
                            AND w.documents_id = d.id)
       ORDER BY rl.text;
  END;

  /* Получение содержимого подписанного договора */
  PROCEDURE contract_get_blob(p_patient_id  IN NUMBER
                             ,p_contract_id IN NUMBER
                             ,p_rc          IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    OPEN p_rc FOR
      SELECT content AS bytes
        FROM solution_data.documents d
       WHERE d.id = p_contract_id;
  END contract_get_blob;

  /* Получение всех шаблонов odt */
  PROCEDURE contract_get_all(p_rc          IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
/*
    OPEN p_rc FOR
      SELECT rl.template_file_id AS template_id
            ,rl.text             AS template_name
            ,t.content
        FROM solution_form.report_list  rl
            ,solution_form.report_group g
            ,solution_data.template_file t
       WHERE rl.report_group_id = g.keyid
         AND rl.status = 1
         AND g.code = 'WEB_ACCOUNT_NODE'
         AND t.id = rl.template_file_id
       ORDER BY rl.keyid;
*/
     OPEN p_rc FOR
       SELECT tfe.template_file_id AS template_id
            ,rl.text              AS template_name
            ,t.content
        FROM solution_form.report_list       rl
            ,solution_form.report_group      g
            ,solution_data.template_file     t
            ,solution_data.template_file_use tfe
       WHERE rl.report_group_id = g.keyid
         AND rl.status = 1
         AND g.code = 'WEB_ACCOUNT_NODE'
         AND tfe.link_id = rl.keyid
         AND tfe.tag = 1
         AND t.id = tfe.template_file_id
       ORDER BY rl.keyid;
  END contract_get_all;

  /* Получение информации по пациенту для документов */
  PROCEDURE contract_get_params(p_patient_id  IN NUMBER
                               ,p_rc          IN OUT pkg_global.ref_cursor_type) AS
    l_dog_num VARCHAR2(100);
    l_amount  NUMBER;
  BEGIN
    IF solution_root.pkg_global.is_procedure_exists('solution_med', 'pkg_web_account_unique', 'fn_get_dog_num') = 1 THEN
      EXECUTE IMMEDIATE 'select pkg_web_account_unique.fn_get_dog_num(' || p_patient_id || ') from dual'
        INTO l_dog_num;
    END IF;

    IF solution_root.pkg_global.is_procedure_exists('solution_med', 'pkg_web_account_unique', 'fn_get_dog_amount') = 1 THEN
      EXECUTE IMMEDIATE 'select pkg_web_account_unique.fn_get_dog_amount(' || p_patient_id || ') from dual'
        INTO l_amount;
    END IF;

    OPEN p_rc FOR
      WITH tab AS
       (SELECT regexp_substr(text, '\[[A-Za-z0-9\_]+\]', 1, LEVEL) AS text
          FROM (SELECT t.note AS text
                  FROM solution_form.report_group t
                 WHERE t.code = 'WEB_ACCOUNT_NODE')
        CONNECT BY regexp_substr(text, '\[[A-Za-z0-9\_]+\]', 1, LEVEL) IS NOT NULL),
      pat AS
       (SELECT nvl(l_dog_num, '         ') AS dog_num
              ,p_pat.fio(p.keyid) AS fio
              ,p_pat.fio(p.keyid, 1) AS fio_short
              ,to_char(p.birthdate, 'dd.mm.yyyy') birthdate
              ,nvl(p_pat.address(p.keyid, 1, 1), lpad(' ', 32, ' ')) AS addr1
              ,nvl(p_pat.address(p.keyid, 2, 1), lpad(' ', 32, ' ')) AS addr2
              ,nvl(p.note, lpad(' ', 15, ' ')) AS email
              ,nvl(p.cellular, lpad(' ', 12, ' ')) AS phone
              ,nvl(p.passser, lpad(' ', 7, ' ')) passser
              ,nvl(p.passnumb, lpad(' ', 12, ' ')) passnumb
              ,nvl(p.passissue, lpad(' ', 20, ' ')) passissue
              ,nvl(to_char(p.passdate, 'dd.mm.yyyy'), lpad(' ', 15, ' ')) passissue_dat
              ,to_char(SYSDATE, 'dd.mm.yyyy') print_dat
              ,p_utils.date_to_russian(SYSDATE) || 'г.' print_dat_text
              ,to_char(l_amount, 'fm9999G999G999G999G9990D00', 'NLS_NUMERIC_CHARACTERS = '', ''') amount
          FROM patient p
         WHERE p.keyid = p_patient_id)
      SELECT REPLACE(REPLACE(text, '['), ']') AS text
            ,val AS "value"
        FROM (SELECT t.text
                    ,p.dog_num AS val
                FROM tab t
                    ,pat p
               WHERE t.text = '[dog_num]'
              UNION ALL
              SELECT t.text
                    ,p.fio
                FROM tab t
                    ,pat p
               WHERE t.text = '[fio]'
              UNION ALL
              SELECT t.text
                    ,p.fio_short
                FROM tab t
                    ,pat p
               WHERE t.text = '[fio_short]'
              UNION ALL
              SELECT t.text
                    ,p.birthdate
                FROM tab t
                    ,pat p
               WHERE t.text = '[birthdate]'
              UNION ALL
              SELECT t.text
                    ,p.addr1
                FROM tab t
                    ,pat p
               WHERE t.text = '[addr1]'
              UNION ALL
              SELECT t.text
                    ,p.addr2
                FROM tab t
                    ,pat p
               WHERE t.text = '[addr2]'
              UNION ALL
              SELECT t.text
                    ,p.email
                FROM tab t
                    ,pat p
               WHERE t.text = '[email]'
              UNION ALL
              SELECT t.text
                    ,p.phone
                FROM tab t
                    ,pat p
               WHERE t.text = '[phone]'
              UNION ALL
              SELECT t.text
                    ,p.passser
                FROM tab t
                    ,pat p
               WHERE t.text = '[passser]'
              UNION ALL
              SELECT t.text
                    ,p.passnumb
                FROM tab t
                    ,pat p
               WHERE t.text = '[passnumb]'
              UNION ALL
              SELECT t.text
                    ,p.passissue
                FROM tab t
                    ,pat p
               WHERE t.text = '[passissue]'
              UNION ALL
              SELECT t.text
                    ,p.passissue_dat
                FROM tab t
                    ,pat p
               WHERE t.text = '[passissue_dat]'
              UNION ALL
              SELECT t.text
                    ,p.print_dat
                FROM tab t
                    ,pat p
               WHERE t.text = '[print_dat]'
              UNION ALL
              SELECT t.text
                    ,p.print_dat_text
                FROM tab t
                    ,pat p
               WHERE t.text = '[print_dat_text]'
              UNION ALL
              SELECT t.text
                    ,p.amount
                FROM tab t
                    ,pat p
               WHERE t.text = '[amount]');
  END contract_get_params;

--                             ,p_blob        IN BLOB   VARCHAR2
  /* Сохранение договора/согласия на пациенте */
  PROCEDURE contract_save_pdf(p_patient_id  IN NUMBER
                             ,p_template_id IN NUMBER
                             ,p_blob        IN BLOB
                             ,p_rc          IN OUT pkg_global.ref_cursor_type) AS
    l_name       VARCHAR2(1000);
    l_tag        NUMBER := 7;
    l_type_id    NUMBER;
    l_rl_id      NUMBER;
    l_result_rec pkg_global.result_rtype;
  BEGIN
    SELECT rl.text || '.PDF '
          ,rl.keyid
      INTO l_name
          ,l_rl_id
      FROM solution_form.report_list       rl
          ,solution_data.template_file_use tfe
     WHERE tfe.link_id = rl.keyid
       AND tfe.tag = 1
       AND tfe.template_file_id = p_template_id
       AND rl.status = 1
       AND rownum = 1;

    SELECT MAX(keyid)
      INTO l_type_id
      FROM lu l
     WHERE l.tag = 327
       AND l.rootcode = l_tag
       AND l.code = 798;

    --Сохранение документа на пациенте
    l_result_rec.identity := pkg_global.get_next_id('SOLUTION_DATA', 'DOCUMENTS');

    INSERT INTO solution_data.documents
      (id
      ,tag
      ,NAME
      ,link_id
      ,patient_id
      ,content
      ,status
      ,store_status
      ,type_id)
    VALUES
      (l_result_rec.identity
      ,l_tag
      ,l_name
      ,p_patient_id
      ,p_patient_id
      ,p_blob
      ,1
      ,-1
      ,l_type_id);

    --Сохранение связки документа на пациенте и документами "на подпись"
    INSERT INTO inetuser.web_form_contract
      (keyid
      ,patient_id
      ,report_list_id
      ,documents_id)
    VALUES
      (pkg_global.get_next_id('INETUSER', 'WEB_FORM_CONTRACT')
      ,p_patient_id
      ,l_rl_id
      ,l_result_rec.identity);

    OPEN p_rc FOR
      SELECT l_result_rec.identity AS id
            ,l_result_rec.error_code AS err_code
            ,'Документ успешно сохранен!' err_text
        FROM dual;
  END contract_save_pdf;

  /**
  * Получить лог событий пациента
  *
  * p_patient_id - идентификатор пациента
  * p_first_date - дата начала поиска
  * p_last_date - дата завершения поиска
  * p_start - с какого элемента ведётся поиск (первый элемент - 1)
  * p_end - по какой элемент ведётся поиск (включительно)
  */
  PROCEDURE get_log_by_patient(p_patient_id IN NUMBER
                              ,p_begin_date IN DATE
                              ,p_end_date  IN DATE
                              ,p_start      IN NUMBER
                              ,p_end        IN NUMBER
                              ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    IF p_start IS NULL
       OR p_end IS NULL THEN
      OPEN p_rc FOR
        SELECT id
              ,session_id
              ,to_char(dat, format_date_front) AS dat_str
              ,action
              ,text
              ,ip_address
              ,browser
              ,os
              ,log_level
              ,success
          FROM inetuser.wa_log
         WHERE applic = applic_name
           AND patient_id = p_patient_id
           AND (p_begin_date IS NULL OR trunc(dat) >= p_begin_date)
           AND (p_end_date IS NULL OR trunc(dat) <= p_end_date)
         ORDER BY dat DESC;
    ELSE
      OPEN p_rc FOR
        SELECT *
          FROM (SELECT a.*
                      ,rownum AS rnum
                  FROM (SELECT id
                              ,session_id
                              ,to_char(dat, format_date_front) AS dat_str
                              ,action
                              ,text
                              ,ip_address
                              ,browser
                              ,os
                              ,log_level
                              ,success
                          FROM inetuser.wa_log
                         WHERE applic = applic_name
                           AND patient_id = p_patient_id
                           AND (p_begin_date IS NULL OR trunc(dat) >= p_begin_date)
                           AND (p_end_date IS NULL OR trunc(dat) <= p_end_date)
                         ORDER BY dat DESC) a
                 WHERE rownum <= p_end)
         WHERE rnum >= p_start;
    END IF;
  END get_log_by_patient;

/**
Всего событий по пациенту
*/

  PROCEDURE get_log_by_patient_size(p_patient_id IN NUMBER
                                   ,p_begin_date IN DATE
                                   ,p_end_date  IN DATE
                                   ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
      OPEN p_rc FOR
        SELECT count(*) AS "size"
          FROM inetuser.wa_log
         WHERE applic = applic_name
           AND patient_id = p_patient_id
           AND (p_begin_date IS NULL OR trunc(dat) >= p_begin_date)
           AND (p_end_date IS NULL OR trunc(dat) <= p_end_date)
           ;

  END get_log_by_patient_size;

  /**
  * Получение Количества событий истории пациента
  * Параметры: p_patient_id - идентификатор пациента
  * p_begin_dat - начальная дата
  * p_end_dat - конечная дата
  **/
  PROCEDURE get_history_events_size(p_patient_id IN NUMBER
                               ,p_begin_dat  IN VARCHAR2
                               ,p_end_dat    IN VARCHAR2
                               ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
  l_begin_dat DATE;
  l_end_dat   DATE;
  BEGIN
    l_begin_dat := to_date(p_begin_dat, format_date_in);
    l_end_dat := to_date(p_end_dat, format_date_in);

    OPEN p_rc FOR
    SELECT count(*) AS "size"
    FROM (
      SELECT t.*,rownum AS rnum
        FROM (SELECT v.keyid AS keyid
                    ,'Консультация' AS typetext
                    ,'visit' AS typehistory
                    , v.dat
                    ,(SELECT text
                        FROM docdep
                       WHERE keyid = v.doctorid) AS doctor
                    ,(SELECT l.text
                        FROM docdep d
                            ,lu     l
                       WHERE d.keyid = v.doctorid
                         AND d.specid = l.keyid) AS spec
                    ,NULL AS research_typ
                    ,1 AS sortcode
                    ,(select d.text from docdep dd,dep d where dd.keyid=v.doctorid and d.keyid=dd.depid) as dep_name
                    ,v.doctorid as docid_exec
                FROM visit v
               WHERE patientid = p_patient_id
                 AND trunc(v.dat) >= nvl(l_begin_dat, to_date('01.01.1900', 'dd.mm.yyyy'))
                 AND trunc(v.dat) <= nvl(l_end_dat, SYSDATE)

                 AND v.dat < SYSDATE --nvl(p_end_dat, SYSDATE + 5000)
              UNION ALL
              SELECT dr.id AS keyid
                    ,'Диагностика' AS typetext
                    ,'diag' AS typehistory
                    ,dr.dat_perform AS dat

                    ,(SELECT d.text AS doc_text

                        FROM solution_diagnostic.res_doctors t
                            ,solution_diagnostic.lu          l
                            ,docdep                          d
                       WHERE t.research_id = dr.id
                         AND d.keyid = t.docdep_id
                         AND t.role_id = l.id
                         AND l.tag = 14
                         AND l.code = (SELECT MIN(l.code)

                                         FROM solution_diagnostic.res_doctors t
                                             ,solution_diagnostic.lu          l
                                             ,docdep                          d
                                        WHERE t.research_id = dr.id
                                          AND d.keyid = t.docdep_id
                                          AND t.role_id = l.id
                                          AND l.tag = 14)
                          group by d.text) AS doctor
                    ,NULL AS spec
                    ,(SELECT rt.text AS research_typ
                        FROM solution_diagnostic.research_typ rt
                       WHERE rt.id = dr.research_typ_id) AS research_typ
                    ,4 AS sortcode
                    ,(select d.text from docdep dd,dep d  where dd.keyid=dr.doc_id and dd.depid=d.keyid) as dep_name
                    ,dr.doc_id as docid_exec
                FROM solution_diagnostic.research dr
               WHERE patient_id = p_patient_id
                 AND trunc(dr.dat_perform) >= nvl(l_begin_dat, to_date('01.01.1900', 'dd.mm.yyyy'))
                 AND trunc(dr.dat_perform) <= nvl(l_end_dat, SYSDATE)

                 AND dr.dat < SYSDATE --nvl(p_end_dat, SYSDATE + 5000)
                 AND dat_perform IS NOT NULL) t
       ORDER BY trunc(t.dat) DESC
               ,t.sortcode
               ,t.keyid) v;

  END get_history_events_size;

  /**
  * Получение событий истории пациента
  * Параметры: p_patient_id - идентификатор пациента
  * p_begin_dat - начальная дата
  * p_end_dat - конечная дата
  **/
  PROCEDURE get_history_events(p_patient_id IN NUMBER
                          ,p_begin_dat  IN VARCHAR2
                          ,p_end_dat    IN VARCHAR2
                          ,p_start      IN NUMBER
                          ,p_end        IN NUMBER
                          ,p_rc         IN OUT pkg_global.ref_cursor_type) AS

    l_param     NUMBER := c_param_506721;
    l_begin_dat DATE;
    l_end_dat   DATE;
  BEGIN

    l_begin_dat := to_date(p_begin_dat, format_date_in);
    l_end_dat   := to_date(p_end_dat, format_date_in);

    OPEN p_rc FOR
/* */   
      SELECT v.keyid
            ,v.typetext
            ,v.typehistory
            ,to_char(v.dat, format_date_front) AS dat
            ,v.doctor
            ,v.doctorid
            ,v.spec ,v.specid
            ,v.sortcode
            ,v.dep_name
            ,v.count_files
/*            
            ,CASE
               WHEN EXISTS (SELECT 1
                       FROM docdep dd
                           ,TABLE(valid_docdep_lpu(p_root_dep_ids => to_char(get_dep_root_id_by_dep_id(dd.depid))
                                                            ,p_spec_id      => dd.specid
                                                            ,p_doc_id       => dd.docid
                                                            ,p_srv_ids      => NULL
                                                            ,p_patient_id   => p_patient_id)) dd1
                           ,TABLE(valid_rnumb(p_docdep_id  => dd1.docdepid
                                                           ,p_dat_from   => l_begin_dat
                                                           ,p_dat_to     => l_end_dat --SYSDATE + l_param
                                                           ,p_patient_id => p_patient_id
                                                           ,p_rectype => null)) rn
                      WHERE dd.keyid = v.docid_exec
                        AND rn.docdepid = dd1.docdepid) THEN
                1
               ELSE
                0
             END AS sched_exists_for_dd_on_visit
*/
, 0 AS sched_exists_for_dd_on_visit             
        FROM (SELECT t.*
                    ,rownum AS rnum
                FROM (SELECT tt.*
                        FROM (
                        
                        SELECT v.keyid AS keyid
                                    ,'Консультация' AS typetext
                                    ,'visit' AS typehistory
                                    ,v.dat
                                    ,dd.docid AS doctorid
                                    ,(SELECT text
                                        FROM docdep
                                       WHERE keyid = v.doctorid) AS doctor
                                    ,(SELECT l.text
                                        FROM docdep d
                                            ,lu     l
                                       WHERE d.keyid = v.doctorid
                                         AND d.specid = l.keyid) AS spec
                                    ,(SELECT d.specid
                                        FROM docdep d
                                            ,lu     l
                                       WHERE d.keyid = v.doctorid
                                         AND d.specid = l.keyid) AS specid
                                    ,NULL AS research_typ
                                    ,1 AS sortcode
                                    ,(SELECT d.text
                                        FROM dep d -- docdep dd,
                                       WHERE -- dd.keyid=v.doctorid and
                                       d.keyid = dd.depid) AS dep_name
                                    ,v.doctorid AS docid_exec
                                    ,(select count(f.id)
from solution_data.report_files f
, solution_data.report_files_link fl
, solution_reg.FORM_RESULT_IN fr
where fl.report_files_id = f.id
and fl.table_name = 'FORM_RESULT_IN'
and fr.id = fl.link_id
and fr.tag =1
and fr.link_id = v.keyid) AS count_files
                                FROM visit v
                                JOIN docdep dd
                                  ON dd.keyid = v.doctorid
                               WHERE patientid = p_patient_id
                                 AND v.dat < SYSDATE
                                 AND trunc(v.dat) BETWEEN nvl(l_begin_dat, to_date('01.01.1900', 'dd.mm.yyyy')) AND
                                     nvl(l_end_dat, SYSDATE)

                              UNION ALL
/* */
                              SELECT dr.id AS keyid
                                    ,'Диагностика' AS typetext
                                    ,'diag' AS typehistory
                                    ,dr.dat_perform AS dat
                                    ,(SELECT d.docid
                                        FROM solution_diagnostic.res_doctors t
                                            ,docdep                          d
                                       WHERE t.research_id = dr.id
                                         AND d.keyid = t.docdep_id
                                         AND t.role_id = (SELECT MIN(l.id)
                                                            FROM solution_diagnostic.res_doctors
                                                                ,solution_diagnostic.lu l
                                                           WHERE research_id = t.research_id
                                                             AND role_id = l.id
                                                             AND l.tag = 14)
                                         group by d.docid) AS doctorid
                                    ,(SELECT d.text AS doc_text
                                        FROM solution_diagnostic.res_doctors t
                                            ,docdep                          d
                                       WHERE t.research_id = dr.id
                                         AND d.keyid = t.docdep_id
                                         AND t.role_id = (SELECT MIN(l.id)
                                                            FROM solution_diagnostic.res_doctors
                                                                ,solution_diagnostic.lu l
                                                           WHERE research_id = t.research_id
                                                             AND role_id = l.id
                                                             AND l.tag = 14)
                                         group by d.text) AS doctor
                                    ,NULL AS spec
                                    ,NULL as specid
                                    ,(SELECT rt.text AS research_typ
                                        FROM solution_diagnostic.research_typ rt
                                       WHERE rt.id = dr.research_typ_id) AS research_typ
                                    ,4 AS sortcode
                                    ,(SELECT d.text
                                        FROM docdep dd
                                            ,dep    d
                                       WHERE dd.keyid = dr.doc_id
                                         AND dd.depid = d.keyid) AS dep_name
                                    ,dr.doc_id AS docid_exec
                                    ,0 AS count_files
                                FROM solution_diagnostic.research dr
                               WHERE patient_id = p_patient_id
                                 AND dr.dat < SYSDATE
                                 AND trunc(dr.dat_perform) BETWEEN nvl(l_begin_dat, to_date('01.01.1900', 'dd.mm.yyyy')) AND
                                     nvl(l_end_dat, SYSDATE)
                                 AND dat_perform IS NOT NULL) tt
                       ORDER BY tt.dat DESC
                               ,tt.sortcode
                               ,tt.keyid) t) v
       WHERE v.rnum <= p_end
         AND rnum >= p_start;

  END get_history_events;

  /*Получение id структуры по по id отделения */
  FUNCTION get_dep_root_id_by_dep_id(p_dep_id IN dep.keyid%TYPE) RETURN NUMBER AS
    l_result       dep.keyid%TYPE;
    l_param_502004 NUMBER := 0; /*Несколько структур в ЛПУ*/
  BEGIN

    l_param_502004 := p_admin.fn_get_param_value_bool('502004');
    IF l_param_502004 = 1 THEN
      /*если в МИС настроена работа со структурами*/
      IF p_dep_id > 0 THEN
        SELECT d_root.keyid
          INTO l_result
          FROM dep d_root
              ,dep d
         WHERE d.keyid = p_dep_id
           AND d_root.sortcode = substr(d.sortcode, 1, 3);
      END IF;
    ELSE
      /*если в МИС не работают со структурами ЛПУ (для давних заказчиков)*/
      IF p_dep_id > 0 THEN
        SELECT d.keyid
          INTO l_result
          FROM dep d
         WHERE d.keyid = p_dep_id;
      END IF;
    END IF;
    RETURN l_result;

  END;
  
/*
* Получить докторов по ЛПУ
*/
  FUNCTION valid_docdep_lpu(p_root_dep_ids IN VARCHAR2
                       ,p_spec_id      IN NUMBER DEFAULT NULL
                       ,p_doc_id       IN NUMBER DEFAULT NULL
                       ,p_srv_ids      IN VARCHAR2 DEFAULT NULL
                       ,p_patient_id   IN NUMBER
                       ,p_lpu_id      IN NUMBER DEFAULT NULL) RETURN t_docdep
    PIPELINED IS
    rec           t_docdep;
    l_cmd         VARCHAR2(4000);
    l_cmd_spec    VARCHAR2(1000);
    l_cmd_doc     VARCHAR2(1000);
    l_cmd_srv     VARCHAR2(1000);
    l_cmd_age_sex VARCHAR2(1000);
    l_cmd_dep     VARCHAR2(1000);
    l_age         VARCHAR2(5) := NULL;
    l_sex         VARCHAR2(5) := NULL;
    l_cmd_lpu    VARCHAR2(4000);
  BEGIN

    l_cmd_lpu :=' ';
    IF p_lpu_id IS NOT NULL AND p_lpu_id>0 THEN
        l_cmd_lpu :=' AND dd.keyid IN (select d1.keyid
                                          FROM attr a1, attr a2, attr a3, docdep d1
                                         WHERE a1.rootid = 0
                                           AND a1.tag = 6
                                           AND a1.code = 1
                                           AND a1.keyid = a2.rootid
                                           AND a2.status = 1
                                           AND a2.keyid = a3.rootid
                                           and a3.linkid = d1.keyid
                                           and d1.status = 1
                                          and substr(fn_get_dep_sortcode(d1.depid), 1, 9) like
       (select a2.sortcode
          FROM attr a1, attr a2, attr a3
         WHERE a1.rootid = 0
           AND a1.tag = 67
           AND a1.code = 202
           AND a1.keyid = a2.rootid
           AND a2.status = 1
           AND a2.keyid = a3.rootid
           and a3.linkid =(' || p_lpu_id || ')
        ))';
    ELSE
-- Отключаем ВАЛДАЙ    
        l_cmd_lpu :=' AND dd.keyid NOT IN (select d1.keyid
                                          FROM attr a1, attr a2, attr a3, docdep d1
                                         WHERE a1.rootid = 0
                                           AND a1.tag = 6
                                           AND a1.code = 1
                                           AND a1.keyid = a2.rootid
                                           AND a2.status = 1
                                           AND a2.keyid = a3.rootid
                                           and a3.linkid = d1.keyid
                                           and d1.status = 1
                                          and substr(fn_get_dep_sortcode(d1.depid), 1, 9) like
       (select a2.sortcode
          FROM attr a1, attr a2, attr a3
         WHERE a1.rootid = 0
           AND a1.tag = 67
           AND a1.code = 202
           AND a1.keyid = a2.rootid
           AND a2.status = 1
           AND a2.keyid = a3.rootid
           and a3.linkid = 3
        ))';
        
    END IF;

    IF p_spec_id IS NOT NULL THEN
      l_cmd_spec := ' and l_spec.keyid = ' || p_spec_id;
    END IF;

    IF p_doc_id IS NOT NULL THEN
      l_cmd_doc := ' and d.keyid = ' || p_doc_id;
    END IF;

    IF p_srv_ids IS NOT NULL THEN
      l_cmd_srv := ' and dd.keyid IN (SELECT ds1.docdepid FROM docserv ds1 WHERE ds1.srvdepid in (' || p_srv_ids || '))';
    END IF;

    IF c_param_506731 = 1
       AND p_patient_id IS NOT NULL THEN
      SELECT gsp_get_age_full_years(p.birthdate, SYSDATE)
            ,p.sex
        INTO l_age
            ,l_sex
        FROM patient p
       WHERE p.keyid = p_patient_id;

      l_cmd_age_sex := ' and ' || nvl(l_age, 0) || ' between nvl(get_age_for_out_specs(''FROM'', dd.keyid), 0) and nvl(get_age_for_out_specs(''TO'', dd.keyid), 150)
       and get_sex_for_out_specs(' || l_sex || ', dd.keyid) = 1';
    END IF;

    IF p_root_dep_ids IS NOT NULL THEN
      l_cmd_dep := ' and (fn_get_attr_link_id(dp.keyid, 7, 701, 1) in (' || p_root_dep_ids || ')
                              OR  substr(dp.sortcode, 1, 3) IN (SELECT dp1.sortcode FROM dep dp1 WHERE dp1.keyid in (' || p_root_dep_ids || ')))';
    END IF;

    l_cmd := 'SELECT distinct d.keyid AS doctorid
                                ,dd.keyid AS docdepid
                                ,dd.depid AS depid
                                ,dd.specid AS specid
                                ,d.lastname AS lastname
                                ,d.secondname AS secondname
                                ,d.firstname AS firstname
                                ,d.positionid AS positionid
                            FROM docdep dd
                                ,doctor d
                                ,dep    dp
                                ,lu     l_spec
                           WHERE d.keyid = dd.docid
                             AND d.status = 1
                             AND dd.status = 1
                             AND dp.keyid = dd.depid
                             AND l_spec.keyid = dd.specid
                             and exists(select null
                                          from docserv ds
                                         where ds.docdepid = dd.keyid
                                           and nvl(pkg_attr.fn_is_object_in_attr_group(ds.srvdepid, 4, 5259, 1), 0) = 1
                                       )
                             AND dd.keyid NOT IN (SELECT d1.keyid /* Врачи, которых не нужно отображать для интернет-записи */
                                                    FROM docdep d1
                                                        ,attr   a1
                                                        ,attr   a2
                                                        ,attr   a3
                                                   WHERE nvl(a1.rootid, 0) = 0
                                                     AND a1.keyid = a2.rootid
                                                     AND a2.keyid = a3.rootid
                                                     AND a3.linkid = d1.keyid
                                                     AND a1.tag = 6
                                                     AND a1.code = 118)
                             ' || l_cmd_lpu || '
                             AND l_spec.keyid NOT IN (SELECT a3.linkid /* Список специальностей, не отображать в интернете */
                                                        FROM attr a1
                                                            ,attr a2
                                                            ,attr a3
                                                       WHERE nvl(a1.rootid, 0) = 0
                                                         AND a1.keyid = a2.rootid
                                                         AND a2.keyid = a3.rootid
                                                         AND a1.tag = 21
                                                         AND a1.code = 6)' || l_cmd_spec || l_cmd_doc ||
             l_cmd_dep || l_cmd_srv || l_cmd_age_sex;
            dbms_output.put_line(l_cmd);

    EXECUTE IMMEDIATE l_cmd BULK COLLECT
      INTO rec;

    IF rec.count > 0 THEN
      FOR i IN rec.first .. rec.last
      LOOP
        PIPE ROW(rec(i));
      END LOOP;
    END IF;

    RETURN;
  END;
  
  /**
  * Список доступных номерков
  * Параметры:
  **/
  FUNCTION valid_rnumb(p_docdep_id  IN NUMBER DEFAULT NULL
                      ,p_dat_from   IN DATE DEFAULT NULL
                      ,p_dat_to     IN DATE DEFAULT NULL
                      ,p_spec_id    IN NUMBER DEFAULT NULL
                      ,p_stac_id    IN NUMBER DEFAULT NULL
                      ,p_rectype    IN NUMBER
                      ,p_patient_id IN NUMBER) RETURN t_rnumb
    PIPELINED IS
    rec            t_rnumb;
    l_cmd          CLOB;
    l_cmd_cond     VARCHAR2(4000);
    l_param_506750 VARCHAR2(100);
    l_age          NUMBER;
  BEGIN

    IF p_patient_id IS NOT NULL THEN
      SELECT gsp_get_age_full_years(p.birthdate, SYSDATE)
        INTO l_age
        FROM patient p
       WHERE p.keyid = p_patient_id;
    END IF;

    IF p_rectype IS NULL THEN
       l_param_506750 := c_param_506750; -- из параметра
       ELSE
       IF p_rectype = 0 THEN
         l_param_506750 := label_code_old;
/* */
         IF p_patient_id IS NOT NULL THEN  -- не пошло - не понятно почему
         --  Проверка на возраст пациента
           IF l_age> 17 THEN
             l_param_506750 := label_code_old;
           ELSE
             l_param_506750 := label_code_kinder;
           END IF;
         ELSE
           l_param_506750 := label_code_old;
         END IF;

       END IF;
       IF p_rectype =1 THEN -- Для видео конференции (1)
         l_param_506750 := label_code_true_conf;
       END IF;
/*03-0832026 - отключил диспансеризацию       
       IF p_rectype =2 THEN -- Для диспансеризации   (2)
         l_param_506750 := label_code_disp;
       END IF;
*/       
    END IF;

    -- собираем условия запроса
    IF p_docdep_id IS NOT NULL THEN
      l_cmd_cond := l_cmd_cond || '
      and r.docdepid = ' || p_docdep_id;
    END IF;

    IF p_spec_id IS NOT NULL THEN
      l_cmd_cond := l_cmd_cond || '
      and dd.specid = ' || p_spec_id;
    END IF;

    IF p_stac_id IS NOT NULL THEN
      l_cmd_cond := l_cmd_cond || '
      and r.stacid = ' || p_stac_id;
    END IF;

    l_cmd := 'SELECT r.keyid as rnumbid
                    ,r.dat
                    ,greatest(r.dat + p_utils.min_2day(r.mins), r.dat1) as dat1
                    ,r.docdepid
                    ,r.paystatus
                    ,r.mins
                    ,nvl(r.time_type, 0) as is_interval
                    ,decode(r.time_type, 1, r.keyid, null) as interval_id
                    ,dd.specid
                    ,r.stacid
               FROM rnumb r
                   ,docdep dd
              WHERE r.docdepid = dd.keyid
                and r.dat > sysdate
                and nvl(r.patientid, 0) = 0
                and r.blstatus = 1
                and r.status !=2  --кроме фиктивных
                and nvl(r.edit_now_status, 0) = 0
                and (''' || l_param_506750 || ''' IS NULL or nvl(fn_get_lu_code(r.stacid), 0) IN (SELECT * FROM TABLE(p_utils.text_to_table(''' || l_param_506750 || '''))))
                and r.dat > gsp_char_2date(''' || p_dat_from || ''')
                and trunc(r.dat) <= gsp_char_2date(''' || p_dat_to || ''')
                ' || l_cmd_cond;
--            dbms_output.put_line(l_cmd);
--                 and (''' || c_param_506750 || ''' IS NULL or nvl(fn_get_lu_code(r.stacid), 0) IN (SELECT * FROM TABLE(p_utils.text_to_table(''' || c_param_506750 || '''))))

    EXECUTE IMMEDIATE l_cmd BULK COLLECT
      INTO rec;

    IF rec.count > 0 THEN
      FOR i IN rec.first .. rec.last
      LOOP
        PIPE ROW(rec(i));
      END LOOP;
    END IF;

    RETURN;
  END;
  
  /**
  * Список талонов пациента
  *
  * @param int p_patient_id - идентификатор пациента
  */
  PROCEDURE get_rnumbs_by_patient(p_patient_id IN NUMBER
                                 ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
  BEGIN

    OPEN p_rc FOR
    SELECT vv.* FROM(
      SELECT r.keyid AS rnumb_id
            , to_char(r.dat, format_date_front) AS dat_bgn
            , to_char(r.dat + r.mins / (24 * 60), format_date_front) AS dat_end
            ,r.room AS cab
            ,(SELECT l.text
                FROM lu l
               WHERE l.keyid = dd.specid
                 AND l.tag = 9) AS spec
            ,(SELECT to_char(clob_agg(table_clob_list(sd.text, chr(10), 1)))
                FROM srvdep sd
                    ,patserv ps
               WHERE r.visitid = ps.visitid
                 AND ps.srvdepid = sd.keyid
                 AND nvl(r.visitid, 0) <> 0) AS srv_text
            ,dd.docid AS doctor_id
            ,(SELECT d.firstname
                FROM doctor d
               WHERE d.keyid = dd.docid) AS firstname
            ,(SELECT d.lastname
                FROM doctor d
               WHERE d.keyid = dd.docid) AS lastname
            ,(SELECT d.secondname
                FROM doctor d
               WHERE d.keyid = dd.docid) AS secondname
            ,(SELECT d.text
                FROM dep d
               WHERE d.keyid = get_dep_root_id_by_dep_id(dd.depid)) AS depname
            ,(SELECT frv.text
                FROM solution_reg.form_result_lpu       fr
                    ,solution_reg.form_result_value_lpu frv
                    ,solution_form.form_item            fi
                    ,solution_form.form                 f
               WHERE fr.link_id = get_dep_root_id_by_dep_id(dd.depid)
                 AND fr.form_id = f.id
                 AND frv.form_result_id = fr.id
                 AND frv.form_item_id = fi.id
                 AND f.code = 'FORM_CONTENT_DEP_WEB'
                 AND upper(fi.code) = 'ADDRES') AS addr
            ,(SELECT frv.text
                FROM solution_reg.form_result_lpu       fr
                    ,solution_reg.form_result_value_lpu frv
                    ,solution_form.form_item            fi
                    ,solution_form.form                 f
               WHERE fr.link_id = get_dep_root_id_by_dep_id(dd.depid)
                 AND fr.form_id = f.id
                 AND frv.form_result_id = fr.id
                 AND frv.form_item_id = fi.id
                 AND f.code = 'FORM_CONTENT_DEP_WEB'
                 AND upper(fi.code) = 'PHONE') AS phone
            ,fn_get_id_lpu(dd.depid) as lpu_id
            ,r.paystatus
            ,NULL AS calc_sum
            ,decode((SELECT l.code
                      FROM lu    l
                     WHERE r.stacid = l.keyid)
                   ,913
                   ,1
                   ,0) is_telemed -- признак телемедицины
                   ,(SELECT t.confer_url
                       FROM inetuser.ws_pay_payment wpp
                           ,inetuser.ws_pay_order   po
                           ,inetuser.trueconf_info t
                      WHERE po.payment_total_id = t.paymentid
                        AND wpp.order_id = po.id
                        AND wpp.paid_status = 1
                        AND t.rnumbid = r.keyid) AS url_telemed  -- ссылка на конференцию
/* Ссылка без оплаты
                   ,(SELECT t.confer_url
                       FROM inetuser.trueconf_info t
                      WHERE t.rnumbid = r.keyid) AS url_telemed  -- ссылка на конференцию
*/
           , 'rnumb' AS type_r
        FROM rnumb  r
            ,docdep dd
       WHERE r.dat > SYSDATE
         AND r.docdepid = dd.keyid
         AND r.patientid = p_patient_id
     UNION ALL
        SELECT v.keyid AS rnumb_id
            , to_char(v.dat, format_date_front) AS dat_bgn
            , to_char(v.dat, format_date_front) AS dat_end
            ,'' AS cab
            ,'' AS spec
            ,'' AS srv_text
            , null/*dd.keyid*/ AS doctor_id
            ,''/*d.firstname*/ AS firstname
            ,''/*d.lastname*/ AS lastname
            ,''/*d.secondname*/ AS secondname
/*            , NULL AS doctor_id
            ,'' AS firstname
            ,'' AS lastname
            ,'' AS secondname
*/
            ,'Бюро госпитализации' AS depname
            ,'пр. Луначарского, д.49' AS addr
            ,'558-98-39' AS phone
            ,null as lpu_id
            ,0 AS paystatus
            ,NULL AS calc_sum
            ,0 AS is_telemed
            ,NULL AS url_telemed  -- ссылка на конференцию
             , 'visit' AS type_r
        FROM visit v --, doctor d, docdep dd
       WHERE v.patientid = p_patient_id
       AND v.vistype=100
      -- AND dd.keyid = v.docid
      -- AND dd.docid=d.keyid
       AND v.dat>SYSDATE) vv
--       AND v.dat>SYSDATE) vv
--       ) vv
       ORDER BY vv.dat_bgn;

  EXCEPTION
    WHEN OTHERS THEN
      OPEN p_rc FOR
        SELECT pkg_global.err_crit     AS err_code
              ,'Ошибка получения номерков.' AS err_text
          FROM dual;
  END get_rnumbs_by_patient;
  
  PROCEDURE history_diagnostic(p_research_id    IN NUMBER
                              ,p_rc             IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    pkg_html.truncate_tmp_html();
    p_hist_html.get_all_res_protocol_info(p_research_id, 0);
    OPEN p_rc FOR
    SELECT clob_agg(table_clob_list(t.text, chr(10), 0, row_num)) text
    FROM tmp_html t
    ORDER BY t.row_num;

  END history_diagnostic;

  PROCEDURE history_visit(p_visit_id    IN NUMBER
                         ,p_rc             IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    pkg_html.truncate_tmp_html();
    p_hist_html.get_visit_info(p_visit_id, 0);
    OPEN p_rc FOR
--    SELECT clob_agg(table_clob_list(t.text, chr(10), 0, row_num)) text
    SELECT t.text, t.row_num
    FROM tmp_html t
    ORDER BY t.row_num;

  END history_visit;

  /**
  * Получить информацию о талоне
  *
  *p_rnumb_id - Идентификатор талона
  */
  PROCEDURE get_rnumb_info(p_rnumb_id IN NUMBER
                          ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
  BEGIN

    OPEN p_rc FOR
      SELECT r.keyid AS rnumb_id
      ,(select MAX(l.text) from lu l where l.tag = 22 and l.keyid = dd.positionid) as doc_dolgnost
--      , get_dep_root_id_by_dep_id(dd.depid)
      , dd.depid
      , fn_get_id_lpu(dd.depid) as lpu_id
--            ,r.dat AS dat_bgn
            ,to_char(r.dat, 'dd.mm.yyyy HH24:MI') AS dat_bgn
            ,to_char(r.dat + (1 / 24 / 60 * r.mins), 'dd.mm.yyyy HH24:MI') AS dat_end
--            ,r.dat + (1 / 24 / 60 * r.mins) AS dat_end
            ,r.room AS cab
            ,(SELECT text
                FROM lu
               WHERE keyid = dd.specid) AS spec
            ,(SELECT listagg(sd.text, CHR(10)) WITHIN GROUP  (ORDER BY ps.createdate)
                FROM srvdep sd
                    ,patserv ps
               WHERE r.visitid = ps.visitid
                 AND ps.srvdepid = sd.keyid
                 AND nvl(r.visitid, 0) <> 0) AS srv_text
            ,dd.docid AS doctor_id
            ,d.lastname
            ,d.firstname
            ,d.secondname
            ,(SELECT d.text
                FROM dep d
               WHERE d.keyid = get_dep_root_id_by_dep_id(dd.depid)) AS depname
            ,(SELECT frv.text
                FROM solution_reg.form_result_lpu       fr
                    ,solution_reg.form_result_value_lpu frv
                    ,solution_form.form_item            fi
                    ,solution_form.form                 f
               WHERE fr.link_id = get_dep_root_id_by_dep_id(dd.depid)
                 AND fr.form_id = f.id
                 AND frv.form_result_id = fr.id
                 AND frv.form_item_id = fi.id
                 AND f.code = 'FORM_CONTENT_DEP_WEB'
                 AND upper(fi.code) = 'ADDRES') AS addr
            ,(SELECT frv.text
                FROM solution_reg.form_result_lpu       fr
                    ,solution_reg.form_result_value_lpu frv
                    ,solution_form.form_item            fi
                    ,solution_form.form                 f
               WHERE fr.link_id = get_dep_root_id_by_dep_id(dd.depid)
                 AND fr.form_id = f.id
                 AND frv.form_result_id = fr.id
                 AND frv.form_item_id = fi.id
                 AND f.code = 'FORM_CONTENT_DEP_WEB'
                 AND upper(fi.code) = 'PHONE') AS phone
            ,r.paystatus
            ,r.visitid
            ,NULL AS calc_sum
            ,decode((SELECT l.code
                      FROM lu    l
                     WHERE r.stacid = l.keyid)
                   ,913
                   ,1
                   ,0) is_telemed -- признак телемедицины
                   ,(SELECT t.confer_url
                       FROM inetuser.ws_pay_payment wpp
                           ,inetuser.ws_pay_order   po
                           ,inetuser.trueconf_info t
                      WHERE po.payment_total_id = t.paymentid
                        AND wpp.order_id = po.id
                        AND wpp.paid_status = 1
                        AND t.rnumbid = r.keyid) AS url_telemed  -- ссылка на конференцию
        FROM rnumb  r
            ,docdep dd
            ,doctor d
       WHERE r.docdepid = dd.keyid
         AND dd.docid = d.keyid
         AND r.keyid = p_rnumb_id;
  END get_rnumb_info;

  
  /**
  * Получение списка платежей услуг по пациенту
  *p_patient_id - ссылка на пациента
  **/
  PROCEDURE payments_by_patient(p_patient_id IN NUMBER
                               ,p_dat_from   IN DATE
                               ,p_dat_to     IN DATE
                               ,p_start      IN NUMBER
                               ,p_end        IN NUMBER
                               ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
    l_result   CLOB;
    l_columns  VARCHAR2(1000);
    l_dat_from VARCHAR2(15) := to_char(p_dat_from, 'dd.mm.yyyy');
    l_dat_to   VARCHAR2(15) := to_char(p_dat_to, 'dd.mm.yyyy');
  BEGIN
    -- format_date_front
    -- 'dd.mm.yyyy hh24:mi'
    /*IF p_start IS NULL
       OR p_end IS NULL THEN
    OPEN p_rc FOR
      WITH t_pay AS(
      SELECT COUNT(*) AS qty
            ,clob_agg(table_clob_list(nvl(sd.webtext, sd.text) || '@!@' ||
                                      fn_get_doc_spec_by_docdepid(pay.docdepid)|| '@!@' ||
                                      nvl(fn_get_doc_sname_by_id(pay.docdepid), 'Не указан') || '@!@' ||
                                      to_char(ps.dat, pkg_global.get_constant_value('format_date_front')) || '@!@' ||
                                      pay.amount, '#!#', 0, sd.webtext)) AS pay_info
            ,pr.payment_totalid AS pr_ptkeyid
            ,pay.payment_totalid AS pt_keyid
        FROM payserv pay
        JOIN patserv ps ON ps.payservid = pay.keyid
        JOIN srvdep sd ON ps.srvdepid = sd.keyid
        LEFT JOIN payserv_return pr ON pr.payservid = pay.keyid
       WHERE pay.patientid = p_patient_id
      --   AND pay.payment_totalid = 27887963
         GROUP BY pr.payment_totalid, pay.payment_totalid
      )
      SELECT 'IMG_PT_NAL' AS img_pt \*Картинка платежа*\
            ,t.pay_type AS pay_type \*типа платежа*\
            ,p_pay.is_pay_type_in_group(t.pay_type_code, 'PAID', 'ALL') paystatus \* Статус оплаченности: 1 - оплачен, 0 - не оплачен *\
--            ,t.dat AS pt_dat \*Дата платежа*\
            ,to_char(t.dat, format_date_front) AS pt_dat_str \*Дата платежа*\
            ,t.amount AS all_amount \*всего к оплате*\
            ,t.nal_amount AS pay_nal \*оплачено за нал*\
            ,t.amount - t.nal_amount AS pay_card \*оплата по карте*\
            ,t.from_avans_amount AS pay_from_avans \*оплата в счет аванса*\
            ,'' \*l.text*\ AS lpu_name \*юридическое лицо*\
            ,t.paymentkeyid AS pt_keyid \*ссылка на сам платеж*\
            ,t.patkeyid
            ,(SELECT wpp.confirmation_url
                FROM inetuser.ws_pay_payment wpp
                    ,inetuser.ws_pay_order   po
               WHERE po.payment_total_id = t.paymentkeyid
                 AND wpp.order_id = po.id
                 AND wpp.paid_status = 0
                 AND NOT EXISTS(SELECT NULL FROM inetuser.ws_pay_payment pp WHERE pp.order_id = po.id AND pp.paid_status = 1)
                 AND nvl(wpp.status, 'canceled') NOT IN ('canceled', 'expired')) AS confirmation_url
            ,(SELECT qty FROM t_pay tp WHERE t.paymentkeyid IN (tp.pr_ptkeyid, tp.pt_keyid)) srv_qty
            ,(SELECT pay_info FROM t_pay tp WHERE t.paymentkeyid IN (tp.pr_ptkeyid, tp.pt_keyid)) srv_info
        FROM v_payment_total t
       WHERE t.patkeyid = p_patient_id
         AND EXISTS(SELECT NULL FROM t_pay tp WHERE t.paymentkeyid IN (tp.pr_ptkeyid, tp.pt_keyid))
         AND trunc(t.dat) BETWEEN p_dat_from AND p_dat_to
       ORDER BY t.dat DESC;
    ELSE
      OPEN p_rc FOR
      WITH t_pay AS(
      SELECT COUNT(*) AS qty
            ,clob_agg(table_clob_list(nvl(sd.webtext, sd.text) || '@!@' ||
                                      replace(fn_get_doc_spec_by_docdepid(pay.docdepid)|| ' (' || nvl(fn_get_doc_sname_by_id(pay.docdepid), '') || ')', ' ()') || '@!@' ||
                                      to_char(ps.dat, pkg_global.get_constant_value('format_date_front')) || '@!@' ||
                                      pay.amount, '#!#', 0, sd.text)) AS pay_info
            ,pr.payment_totalid AS pr_ptkeyid
            ,pay.payment_totalid AS pt_keyid
        FROM payserv pay
        JOIN patserv ps ON ps.payservid = pay.keyid
        JOIN srvdep sd ON ps.srvdepid = sd.keyid
        LEFT JOIN payserv_return pr ON pr.payservid = pay.keyid
       WHERE pay.patientid = p_patient_id
      --   AND pay.payment_totalid = 27887963
         GROUP BY pr.payment_totalid, pay.payment_totalid
      )
        SELECT *
          FROM (SELECT a.*
                      ,rownum AS rnum
                  FROM (SELECT 'IMG_PT_NAL' AS img_pt \*Картинка платежа*\
            ,t.pay_type AS pay_type \*типа платежа*\
            ,p_pay.is_pay_type_in_group(t.pay_type_code, 'PAID', 'ALL') paystatus \* Статус оплаченности: 1 - оплачен, 0 - не оплачен *\
            ,to_char(t.dat, format_date_front) AS pt_dat_str \*Дата платежа*\
            ,t.amount AS all_amount \*всего к оплате*\
            ,t.nal_amount AS pay_nal \*оплачено за нал*\
            ,t.amount - t.nal_amount AS pay_card \*оплата по карте*\
            ,t.from_avans_amount AS pay_from_avans \*оплата в счет аванса*\
            ,'' \*l.text*\ AS lpu_name \*юридическое лицо*\
            ,t.paymentkeyid AS pt_keyid \*ссылка на сам платеж*\
            ,t.patkeyid
            ,(SELECT wpp.confirmation_url
                FROM inetuser.ws_pay_payment wpp
                    ,inetuser.ws_pay_order   po
               WHERE po.payment_total_id = t.paymentkeyid
                 AND wpp.order_id = po.id
                 AND wpp.paid_status = 0
                 AND NOT EXISTS(SELECT NULL FROM inetuser.ws_pay_payment pp WHERE pp.order_id = po.id AND pp.paid_status = 1)
                 AND nvl(wpp.status, 'canceled') NOT IN ('canceled', 'expired')) AS confirmation_url
            ,(SELECT qty FROM t_pay tp WHERE t.paymentkeyid IN (tp.pr_ptkeyid, tp.pt_keyid)) srv_qty
            ,(SELECT pay_info FROM t_pay tp WHERE t.paymentkeyid IN (tp.pr_ptkeyid, tp.pt_keyid)) srv_info
        FROM v_payment_total t
       WHERE t.patkeyid = p_patient_id
         AND EXISTS(SELECT NULL FROM t_pay tp WHERE t.paymentkeyid IN (tp.pr_ptkeyid, tp.pt_keyid))
         AND trunc(t.dat) BETWEEN p_dat_from AND p_dat_to
       ORDER BY t.dat DESC
       ) a
                 WHERE rownum <= p_end)
         WHERE rnum >= p_start;
    END IF;*/
    l_result := '
    WITH t_pay AS(
      SELECT COUNT(*) AS qty
            ,clob_agg(table_clob_list(nvl(sd.webtext, sd.text) || ''@!@'' ||
                                      dd.docid || ''@!@'' ||
                                      fn_get_doc_sname_by_id(ps.docid_exec) || ''@!@'' ||
                                      fn_get_lu_name(dd.specid) || ''@!@'' ||
                                      to_char(ps.dat, pkg_global.get_constant_value(''format_date_front'')) || ''@!@'' ||
                                      pay.amount
                                    , ''#!#'', 0, sd.text)) AS pay_info
            ,pr.payment_totalid AS pr_ptkeyid
            ,pay.payment_totalid AS pt_keyid
        FROM payserv pay
        JOIN patserv ps ON ps.payservid = pay.keyid
        JOIN srvdep sd ON ps.srvdepid = sd.keyid
        LEFT JOIN payserv_return pr ON pr.payservid = pay.keyid
        LEFT JOIN docdep dd ON dd.keyid = ps.docid_exec
       WHERE pay.patientid = ' || p_patient_id || '
         GROUP BY pr.payment_totalid, pay.payment_totalid
      )';
      IF p_start IS NULL THEN
        l_columns := '
      SELECT COUNT(*) from(';
      ELSE
        l_columns := '
      SELECT *
          FROM (';
      END IF;
      l_result := l_result || l_columns || '
      SELECT a.*
                      ,rownum AS rnum
                  FROM (
      SELECT ''IMG_PT_NAL'' AS img_pt /*Картинка платежа*/
            ,t.pay_type AS pay_type /*типа платежа*/
            ,p_pay.is_pay_type_in_group(t.pay_type_code, ''PAID'', ''ALL'') paystatus /* Статус оплаченности: 1 - оплачен, 0 - не оплачен */
            ,to_char(t.dat, ''dd.mm.yyyy hh24:mi'') AS pt_dat_str /*Дата платежа*/
            ,t.amount AS all_amount /*всего к оплате*/
            ,t.nal_amount AS pay_nal /*оплачено за нал*/
            ,t.amount - t.nal_amount AS pay_card /*оплата по карте*/
            ,t.from_avans_amount AS pay_from_avans /*оплата в счет аванса*/
            ,'''' /*l.text*/ AS lpu_name /*юридическое лицо*/
            ,t.paymentkeyid AS pt_keyid /*ссылка на сам платеж*/
            ,t.patkeyid
            ,(SELECT max(wpp.confirmation_url)
                FROM inetuser.ws_pay_payment wpp
                    ,inetuser.ws_pay_order   po
               WHERE po.payment_total_id = t.paymentkeyid
                 AND wpp.order_id = po.id
                 AND wpp.paid_status = 0
                 AND NOT EXISTS(SELECT NULL FROM inetuser.ws_pay_payment pp WHERE pp.order_id = po.id AND pp.paid_status = 1)
                 AND nvl(wpp.status, ''canceled'') NOT IN (''canceled'', ''expired'')) AS confirmation_url
            ,(SELECT qty FROM t_pay tp WHERE t.paymentkeyid IN (tp.pr_ptkeyid, tp.pt_keyid)) srv_qty
            ,(SELECT pay_info FROM t_pay tp WHERE t.paymentkeyid IN (tp.pr_ptkeyid, tp.pt_keyid)) srv_info
            ,(select max(ffd.ffd_url)
                from inetuser.ws_pay_order po
                   , inetuser.ws_pay_payment_ffd ffd
                where po.payment_total_id = t.paymentkeyid
                and ffd.order_id = po.id
                and ffd.ffd_url is not null) AS ffd_url
        FROM v_payment_total t
       WHERE t.patkeyid = ' || p_patient_id || '
         AND EXISTS(SELECT NULL FROM t_pay tp WHERE t.paymentkeyid IN (tp.pr_ptkeyid, tp.pt_keyid))
         AND trunc(t.dat) BETWEEN to_date(''' || l_dat_from || ''', ''dd.mm.yyyy'') AND to_date(''' || l_dat_to || ''', ''dd.mm.yyyy'')
       ORDER BY t.dat DESC
       ) a' || CASE WHEN p_end IS NOT NULL
                     THEN '
                 WHERE rownum <= ' || p_end
                 END || ')' ||
         CASE WHEN p_start IS NOT NULL
              THEN '
         WHERE rnum >= ' || p_start
          END;
     dbms_output.put_line(l_result);
     OPEN p_rc FOR l_result;

  END payments_by_patient;

 /*
  * Получение количества платежей услуг по пациенту
  *p_patient_id - ссылка на пациента
  **/
  PROCEDURE payments_by_patient_size(p_patient_id IN NUMBER
                               ,p_dat_from   IN DATE
                               ,p_dat_to     IN DATE
                               ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
  l_qty NUMBER;
  BEGIN
    /*OPEN p_rc FOR
      SELECT count(*) AS "size"
        FROM v_payment_total t
       WHERE t.patkeyid = p_patient_id
         AND trunc(t.dat) BETWEEN p_dat_from AND p_dat_to;*/
    payments_by_patient(p_patient_id => p_patient_id,
                                        p_dat_from   => p_dat_from,
                                        p_dat_to     => p_dat_to,
                                        p_start      => NULL,
                                        p_end        => NULL,
                                        p_rc         => p_rc);
    FETCH p_rc
      INTO l_qty;
    OPEN p_rc FOR
      SELECT l_qty AS "size"
        FROM dual;
  END payments_by_patient_size;
  
  /**
  * Создание платежа в зависимости от типа.
  * Для штатной работы должны быть заполнены параметр 50 и 16150
  */

  PROCEDURE payment_temp(p_patientid      IN NUMBER
                        ,p_payment_lu_tag IN NUMBER /*тип платежа (LU.TAG=24). Он же и тип и способ оплаты. Code 22 - Аванс Карта,Code 23-Расчет карта*/
                        ,p_amount         IN NUMBER
                         /*,p_payment_dat    IN DATE DEFAULT SYSDATE*/
                        ,p_email  IN VARCHAR2
                        ,p_phone  IN VARCHAR2
                        ,p_police IN NUMBER
                         /*,p_return_url     IN VARCHAR2*/
                        ,p_rc IN OUT pkg_global.ref_cursor_type) AS
    l_result_rec             pkg_global.result_rtype;
    l_agr_id                 NUMBER;
    l_srvdep_id              NUMBER;
    l_payment_total_avans_id pkg_global.result_rtype;
    l_ws_pay_order_id        pkg_global.result_rtype;
    l_payserv_id             pkg_global.result_rtype;

    p_rc_order              pkg_global.ref_cursor_type;
    p_rc_avans              pkg_global.ref_cursor_type;
    p_rc_real_payment_total pkg_global.ref_cursor_type;

    p_return_url VARCHAR2(400);

  BEGIN
    IF p_email IS NULL
       AND p_phone IS NULL THEN
      l_result_rec.error_code := pkg_global.err_crit;
      l_result_rec.error_text := 'Заполните номер телефона или почту!';
    END IF;

    IF l_result_rec.error_code <> pkg_global.err_crit THEN
      --Параметр адреса возврата
      p_return_url := p_admin.fn_get_param_value_text('WEB_LK_YANDEX_RETURN_URL');

      IF p_payment_lu_tag = 22 THEN
        /*создание авансового платежа*/
        payment_temp_avans(p_patientid, p_amount, SYSDATE, p_rc_avans);
        FETCH p_rc_avans
          INTO l_payment_total_avans_id;
        /*получение идентификатора от платежной системы*/
        pkg_ws_pay.add_order_by_payment_total(l_payment_total_avans_id.identity
                                             ,fn_get_only_numbers(p_phone)
                                             ,p_email
                                             ,p_return_url
                                             ,1
                                             ,p_rc_order);

        FETCH p_rc_order
          INTO l_ws_pay_order_id;

        l_result_rec.identity := l_ws_pay_order_id.identity;
      END IF;
    END IF;
    pkg_global.fill_result_cursor(l_result_rec, p_rc);
  END;
  
  /**
  * Оплата Аванса.
  * Для штатной работы должны быть заполнены параметр 50 и 16150
  */
  PROCEDURE payment_temp_avans(p_patientid   IN NUMBER
                              ,p_amount      IN NUMBER
                              ,p_payment_dat IN DATE DEFAULT SYSDATE
                              ,p_rc          IN OUT pkg_global.ref_cursor_type) AS
    l_result_rec           pkg_global.result_rtype;
    l_agr_id               NUMBER;
    l_srvdep_id            NUMBER;
    l_payment_total_tmp_id pkg_global.result_rtype;
    l_payment_total_new_id pkg_global.result_rtype;
    l_payserv_id           pkg_global.result_rtype;

    p_rc_tmp                pkg_global.ref_cursor_type;
    p_rc_tmp_payserv        pkg_global.ref_cursor_type;
    p_rc_real_payment_total pkg_global.ref_cursor_type;
  BEGIN
    /*определяем шифр по умолчанию*/
    l_agr_id := p_admin.fn_get_param_value_linkid('50');
    /*определяем аванас по умолчанию*/
    SELECT sd.keyid
      INTO l_srvdep_id
      FROM srvdep sd
     WHERE TRIM(sd.code) = TRIM(p_admin.fn_get_param_value_text('16150'))
       AND sd.status = 1
       AND rownum = 1;
    /*формируем временный платеж*/
    p_pay_2.save_tmp_payment_total( /*p_payment_total_id    =>*/'-1'
                                  , /*p_deleted_payserv_ids => */''
                                  , /*p_patient_id          =>*/p_patientid
                                  , /*p_agrid               =>*/l_agr_id
                                  , /*p_police_id           => */NULL
                                  , /*p_type_code           => */22
                                  , /*p_link_tag            =>*/NULL
                                  , /*p_link_id             => */NULL
                                  , /*p_pay_oday_id         => */NULL
                                  , /*p_bring_persid        => */NULL
                                  , /*p_customer_id         => */NULL
                                  , /*p_dep_id              => */NULL
                                  , /*p_check_code          => */NULL
                                  , /*p_text                => */'Онлайн пополнение Аванса из ЛК'
                                  , /*p_transfer_type_id    => */NULL
                                  ,p_rc_tmp);

    /*формирование услуги*/
    FETCH p_rc_tmp
      INTO l_payment_total_tmp_id;
    p_pay_2.payserv_save(p_patient_id       => p_patientid
                        ,p_payment_total_id => l_payment_total_tmp_id.identity
                        ,p_srvdep_id        => l_srvdep_id
                        ,p_price            => 1
                        ,p_amount           => p_amount
                        ,p_discount         => 0
                        ,p_qty              => p_amount
                        ,p_perc             => 1
                        ,p_dat              => p_payment_dat
                        ,p_agr_id           => l_agr_id
                        ,p_cito_stat        => 0
                        ,p_dat_end          => p_payment_dat
                        ,p_price_lu_id      => 0
                        ,p_rc               => p_rc_tmp_payserv);

    FETCH p_rc_tmp_payserv
      INTO l_payserv_id;
    /*формирование реального платежа из временного*/
    p_pay_2.create_payment_total_from_tmp(
                                          /*p_tmp_payment_total_id =>*/l_payment_total_tmp_id.identity
                                         ,
                                          /*p_paytype_code         => */NULL
                                         ,
                                          /*p_pay_oday_id          => */NULL
                                         ,
                                          /*p_lpu_id               => */NULL
                                         ,
                                          /*p_is_moneyback         => */0
                                         ,
                                          /*p_summ_total           => */p_amount
                                         ,
                                          /*p_summ_nal             => */0
                                         ,
                                          /*p_summ_card            => */p_amount
                                         ,
                                          /*p_summ_sbp             => */0,0
--                                         ,
--                                          /*p_summ_avans           => */0
                                         ,
                                          /*p_summ_debt            => */0
                                         ,
                                          /*p_list_payserv_ids     => */l_payserv_id.identity
                                         ,
                                          /*p_list_payserv_qtys    => */p_amount
                                         ,
                                          /*p_is_single_payment    => */1
                                         ,
                                          /*p_serv_check_code      => */NULL
                                         ,p_rc_real_payment_total);

    /*финализация*/
    FETCH p_rc_real_payment_total
      INTO l_payment_total_new_id;
    p_pay_2.payment_total_finalize( /*p_tmp_payment_total_id  => */l_payment_total_tmp_id.identity
                                  ,
                                   /*p_new_payment_total_ids => */l_payment_total_new_id.identity
                                  ,
                                   /* p_is_single_payment     => */1
                                  ,p_rc);
    UPDATE payment_total pt
       SET luid =
           (SELECT lu.keyid
              FROM lu
             WHERE tag = 24
               AND code = 12)
     WHERE pt.keyid = l_payment_total_new_id.identity;
    /*помещаем данные в курсор для дальнейшей обработки*/
    l_result_rec.identity := l_payment_total_new_id.identity;
    pkg_global.fill_result_cursor(l_result_rec, p_rc);

  EXCEPTION
    WHEN OTHERS THEN
      l_result_rec.error_code := pkg_global.err_crit;
      l_result_rec.error_text := 'Ошибка при финализации ОНЛАЙН оплаты.';
      solution_log.p_log.err(p_err_text   => l_result_rec.error_text
                            ,p_err_type   => l_result_rec.error_code
                            ,p_err_code   => 'P_PAY_2.PAYMENT_TOTAL_FINALIZE'
                            ,p_link_tag   => solution_root.pkg_global.gc_tag_med_payment_total
                            ,p_link_id    => l_payment_total_new_id.identity
                            ,p_patient_id => p_patientid);
      pkg_global.fill_result_cursor(l_result_rec, p_rc);

  END payment_temp_avans;


  /**
  * Получение баланса по пациенту
  */
  PROCEDURE get_balans_by_patient(p_patientid  IN NUMBER
                                   ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
      OPEN p_rc FOR
    SELECT sum(pt.amount - nvl(pt.usedamount, 0)) AS amount
      FROM payment_total pt
      JOIN lu l
        ON pt.luid = l.keyid
     WHERE p_pay.is_pay_type_in_group(l.code, 'PAID', 'ADVANCE') = 1
       AND pt.patientid = p_patientid
       AND nvl(pt.rootid, 0) = 0
       AND nvl(pt.status, 0) = 0
       AND nvl(pt.usedamount, 0) < pt.amount
     ORDER BY pt.dat;
  END get_balans_by_patient;
  
/* Получить URL для оплаты */
  PROCEDURE get_payment_url(p_order_id IN inetuser.ws_pay_order.id%TYPE -- [число], идентификатор заказа в МИС
                           ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    OPEN p_rc FOR
      select po.confirmation_url as confirmationurl
      FROM inetuser.ws_pay_payment po
      where po.order_id = p_order_id;
  END get_payment_url;
  
/* Получить почту по заказу */
  PROCEDURE get_email_from_order(p_order_id IN inetuser.ws_pay_order.id%TYPE -- [число], идентификатор заказа в МИС
                           ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    OPEN p_rc FOR
      select p.note as email, p.phone, pay_params_email_def as emailClinic
      from v_payment_total vpt, patient p
      where p.keyid = vpt.patkeyid
      and vpt.paymentkeyid = (select max(po.payment_total_id) from inetuser.ws_pay_order po where po.id = p_order_id);
  END get_email_from_order;
  
  /**
  * Список специальностей
  * Параметры:
    p_dat_from - Дата начала периода
    p_dat_to   - Дата окончания периода
    p_stac_id  - спец.отметки из фильтра
    p_lpu_id - id ЛПУ
  **/
  PROCEDURE get_spec_list(p_dat_from IN DATE
                         ,p_dat_to   IN DATE
                         ,p_lpu_id  IN NUMBER
                         ,p_stac_id  IN NUMBER
                         ,p_rectype  IN NUMBER
                         ,p_patient_id IN NUMBER
                         ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    OPEN p_rc FOR
      SELECT DISTINCT l.keyid
            ,l.text
        FROM lu l
            ,TABLE(valid_docdep_lpu(p_root_dep_ids => NULL,
                                                p_spec_id      => NULL,
                                                p_doc_id       => NULL,
                                                p_srv_ids      => NULL,
                                                p_patient_id   => NULL,
--                                                p_lpu_id      => NULL)) d
                                                p_lpu_id      => p_lpu_id)) d
            ,TABLE(valid_rnumb(p_docdep_id  => d.docdepid
                                              ,p_dat_from   => p_dat_from
                                              ,p_dat_to     => p_dat_to
                                              ,p_spec_id    => d.specid
                                              ,p_stac_id    => p_stac_id
                                              ,p_patient_id => NULL
                                              ,p_rectype => p_rectype)) r
       WHERE l.tag = 9
         AND l.status = 1
         AND l.keyid = d.specid
         ORDER BY l.text;

  END get_spec_list;
  
  PROCEDURE frame2_get_spec_list( p_rc IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    get_spec_list(  p_dat_from => SYSDATE,
                                              p_dat_to => SYSDATE + 40,
                                              p_lpu_id => null,
                                              p_stac_id => null,
                                              p_rectype => null,
                                              p_patient_id => null, --fn_get_patientid(p_kinder),
                                              p_rc => p_rc);
  END frame2_get_spec_list;
  
  /**
  * Список врачей
  * Параметры:
    p_spec_id    - Идентификатор специальности
    p_dat_from   - Период, начало
    p_dat_to     - Период, окончание
  **/
  PROCEDURE get_doc_list(p_spec_id  IN NUMBER
                        ,p_dat_from IN DATE
                        ,p_dat_to   IN DATE
                        ,p_stac_id  IN NUMBER
                        ,patient_id IN NUMBER
                        ,p_lpu_id IN NUMBER
                        ,p_rectype  IN NUMBER
                        ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    OPEN p_rc FOR
      SELECT doctorid
            ,l_name
            ,f_name
            ,s_name
            ,note
            ,to_char(MIN(trunc(dat)), 'dd.mm.yyyy HH24:MI') AS dat_bgn
            ,to_char(MAX(trunc(dat)), 'dd.mm.yyyy HH24:MI') AS dat_end
            ,COUNT(*) AS rcount
            ,(select MAX(l.text) from lu l where l.tag = 22 and l.keyid = positionid) as dolgnost

        FROM(
      SELECT d1.doctorid AS doctorid
            ,initcap(d1.lastname) AS l_name
            ,initcap(d1.firstname) AS f_name
            ,initcap(d1.secondname) AS s_name
            ,'Описание' AS note
            ,r.dat
            ,d1.specid
            ,d1.positionid
        FROM /*doctor d
            ,*/TABLE(valid_docdep_lpu(p_root_dep_ids => NULL,
                                                p_spec_id      => p_spec_id,
                                                p_doc_id       => NULL,
                                                p_srv_ids      => NULL,
                                                p_patient_id   => NULL,
                                                p_lpu_id      => p_lpu_id)) d1
            ,TABLE(valid_rnumb(p_docdep_id  => NULL/*d1.docdepid*/
                                              ,p_dat_from   => p_dat_from
                                              ,p_dat_to     => p_dat_to
                                              ,p_spec_id    => p_spec_id
                                              ,p_stac_id    => p_stac_id
                                              ,p_patient_id => patient_id --NULL
                                              ,p_rectype => p_rectype)) r
       WHERE 0=0 -- d1.depid != 2320
         AND r.docdepid = d1.docdepid
        /* AND d1.doctorid = d.keyid
         AND d.status = 1*/
           )
       GROUP BY doctorid
               ,l_name
               ,f_name
               ,s_name
               ,note
               ,positionid
      ORDER BY l_name;

  END get_doc_list;
  
  PROCEDURE frame2_get_doc_list(p_spec_id  IN NUMBER
                        ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    get_doc_list(p_spec_id => p_spec_id
                  ,p_dat_from => SYSDATE
                  ,p_dat_to => SYSDATE + 40
                  ,p_stac_id => null
                  ,patient_id => null --fn_get_patientid(p_kinder)
                  ,p_lpu_id => null --p_lpu_id
                  ,p_rectype => null -- p_rectype
                  ,p_rc => p_rc);

  END frame2_get_doc_list;
  
  PROCEDURE frame2_get_doc_list_all(p_rc       IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
      OPEN p_rc FOR
        select d1.doctorid AS doctorid
                    ,initcap(d1.lastname) AS l_name
                    ,initcap(d1.firstname) AS f_name
                    ,initcap(d1.secondname) AS s_name
                    ,d1.specid
        from TABLE(valid_docdep_lpu(p_root_dep_ids => NULL,
                                                        p_spec_id      => null,
                                                        p_doc_id       => null,
                                                        p_srv_ids      => NULL,
                                                        p_patient_id   => NULL,
                                                        p_lpu_id      => NULL)) d1
            ,TABLE(valid_rnumb(p_docdep_id  => d1.docdepid
                                              ,p_dat_from   => sysdate
                                              ,p_dat_to     => sysdate + 30
                                              ,p_spec_id    => null
                                              ,p_stac_id    => null
                                              ,p_patient_id => null -- p_patient_id -- NULL
                                              ,p_rectype => null)) r
        where r.docdepid = d1.docdepid                                                
        GROUP BY d1.doctorid, d1.lastname, d1.firstname,d1.secondname, d1.specid                                                
        order by d1.doctorid;
      
  END frame2_get_doc_list_all;
 
  /**
  * Список услуг по врачу
  * Параметры:
    p_doctor_id - Идентификатор врача
    p_spec_id   - Идентификатор специальности
  **/
  PROCEDURE get_serv_list(p_doctor_id IN NUMBER
                         ,p_spec_id   IN NUMBER
                         ,p_dat_from  IN DATE
                         ,p_dat_to    IN DATE
                         ,p_stac_id   IN NUMBER
                         ,p_rc        IN OUT pkg_global.ref_cursor_type) AS
    l_agr_id       NUMBER := nvl(p_admin.fn_get_param_value_linkid('506749'), p_admin.fn_get_param_value_linkid('50'));
  BEGIN
    OPEN p_rc FOR
      SELECT DISTINCT sd.keyid
            ,sd.code
            ,nvl(sd.webtext, sd.text) AS text
            ,gsp_get_price(l_agr_id, sd.keyid, gsp_date_2char(SYSDATE)) AS price
            ,decode(sd.tag, 104, 1, 0) AS is_telemed
            ,fn_is_online_pay(sd.keyid) AS is_online_pay
        FROM srvdep sd
            ,docserv ds
            ,docdep dd
       WHERE ds.srvdepid = sd.keyid
         AND (sd.status = 1 OR c_param_506748 = sd.code)
         AND dd.keyid = ds.docdepid
         AND dd.specid = p_spec_id
         AND dd.docid = p_doctor_id
         AND nvl(pkg_attr.fn_is_object_in_attr_group(sd.keyid, 4, 5259, 1), 0) = 1
         order by decode(sd.code, to_char(c_param_506748), 1, 2), text;
  END get_serv_list;
 
  /*
  * признак обязательности оплаты онлайн
  */
  FUNCTION fn_is_online_pay(p_srv_id   IN NUMBER) RETURN NUMBER AS
    l_result    NUMBER := 1;
    l_srv_tag   NUMBER;
  BEGIN

    IF l_result = 0 THEN

      SELECT sd.tag
        INTO l_srv_tag
        FROM srvdep sd
       WHERE sd.keyid = p_srv_id;

      IF l_srv_tag = 104 -- тип услуги - телемедицина
       THEN
        l_result := 1;
      ELSIF l_srv_tag = 101 THEN -- неотложная помощь ТЕСТ
        l_result := 1;/*
      ELSIF l_srv_tag = 3 THEN
        -- для теста удаления
        l_result := 1;*/
      END IF;

    END IF;

    IF p_srv_id = 25595 THEN -- ОМС ВАЛДАЙ
        l_result := 0;
    END IF;


    RETURN(l_result);
  EXCEPTION
    WHEN OTHERS THEN
      RETURN 0;
  END;

  PROCEDURE frame2_get_serv_list(p_doctor_id IN NUMBER
                                ,p_spec_id   IN NUMBER
                                ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    get_serv_list(p_doctor_id => p_doctor_id
                                                ,p_spec_id => p_spec_id
                                                ,p_dat_from  => null
                                                ,p_dat_to    => null
                                                ,p_stac_id   => null
                                                ,p_rc => p_rc);
  END frame2_get_serv_list;

  
/* Получить ссылку на врача*/
  PROCEDURE frame2_get_doc_url(p_doctor_id IN NUMBER
                         ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    OPEN p_rc FOR
      select
      pkg_protocol_universal.get_answer(p_link_id       => p_doctor_id, --doctor.keyid/docdep.keyid,
                                        p_question_code => '1',
                                        p_protocol_code => 'FORM_CONTENT_DOCTOR_WEB',
                                        p_field         => 'text',
                                        p_location      => 'REGLPU') AS URL
      from dual;
  END frame2_get_doc_url;
  

/* Получить список номерков */
  PROCEDURE frame2_get_rnumb_list(p_doctor_id  IN NUMBER
                          ,p_spec_id    IN NUMBER
                          ,p_srv_ids    IN VARCHAR2
                          ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    get_rnumb_list(p_doctor_id => p_doctor_id
                                                ,p_spec_id => p_spec_id
                                                ,p_begin_dat => to_char(SYSDATE, 'yyyy-mm-dd')
                                                ,p_end_dat => to_char(SYSDATE + 40, 'yyyy-mm-dd')
                                                ,p_stac_id => null
                                                ,p_patient_id => null --fn_get_patientid(p_kinder)
                                                ,p_srv_ids => p_srv_ids
                                                ,p_lpu_id => null -- p_lpu_id
                                                ,p_rectype => null --p_rectype
                                                ,p_rc => p_rc);
  END frame2_get_rnumb_list;
  
  /**
  * Список номерков
  * Параметры:
    p_doctor_id   - Идентификатор врача
    p_spec_id     - Идентификатор специальности
    p_dat_from    - Период, начало
    p_dat_to      - Период, окончание
    p_patient_id  - Идентификатор пациента
  **/

  PROCEDURE get_rnumb_list(p_doctor_id  IN NUMBER
                          ,p_spec_id    IN NUMBER
                          ,p_begin_dat  IN VARCHAR2
                          ,p_end_dat    IN VARCHAR2
                          ,p_stac_id    IN NUMBER
                          ,p_patient_id IN NUMBER
                          ,p_srv_ids    IN VARCHAR2
                          ,p_lpu_id    IN NUMBER
                          ,p_rectype    IN NUMBER
                          ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
  l_begin_dat DATE;
  l_end_dat   DATE;
  BEGIN
    l_begin_dat := to_date(p_begin_dat, format_date_in);
    l_end_dat := to_date(p_end_dat, format_date_in);
    OPEN p_rc FOR
      SELECT r.rnumbid
            ,to_char(r.dat, format_date_front) AS dat_begin_str
            ,to_char(r.dat1, format_date_front) AS dat_end_str
            ,d1.depid
            ,REPLACE(d.text, '"', '') AS depname
             ,fn_get_id_lpu(d1.depid) as lpu_id
-- where dd.docid=582
-- and dd.depid = 2396;
            
            ,r.paystatus
--            ,decode(r.stacid, label_is_online_pay, 1,0) is_online_pay -- признак платной метки - сверка с меткой
            ,CASE WHEN r.stacid = label_is_online_pay OR r.stacid = label_true_conf THEN 1 ELSE 0 END AS is_online_pay
            ,r.stacid
--            ,r.stacid as is_online_pay
-- label_is_online_pay
            ,r.is_interval
            ,r.interval_id
            ,decode((SELECT l.code
                      FROM lu    l
                     WHERE r.stacid = l.keyid)
                   ,913
                   ,1
                   ,0) is_telemed -- признак телемедицины
        FROM dep d
            ,TABLE(valid_docdep_lpu(p_root_dep_ids => NULL,
                                                p_spec_id      => p_spec_id,
                                                p_doc_id       => p_doctor_id,
                                                p_srv_ids      => NULL,
                                                p_patient_id   => NULL,
                                                p_lpu_id      => p_lpu_id)) d1
            ,TABLE(valid_rnumb(p_docdep_id  => d1.docdepid
                                              ,p_dat_from   => l_begin_dat
                                              ,p_dat_to     => l_end_dat
                                              ,p_spec_id    => p_spec_id
                                              ,p_stac_id    => p_stac_id
                                              ,p_patient_id => p_patient_id -- NULL
                                              ,p_rectype => p_rectype)) r
       WHERE r.docdepid = d1.docdepid
         AND d1.depid = d.keyid
       ORDER BY r.dat;
  END get_rnumb_list;
  
/* Получить название ЛПУ */
  FUNCTION fn_get_id_lpu(p_depid IN NUMBER) RETURN NUMBER IS
    l_result_value NUMBER;
  BEGIN
    l_result_value := 0;
    select a3.linkid
    into l_result_value
              FROM attr a1, attr a2, attr a3
             WHERE a1.rootid = 0
               AND a1.tag = 67
               AND a1.code = 202
               AND a1.keyid = a2.rootid
               AND a2.status = 1
               AND a2.keyid = a3.rootid
    AND a2.sortcode = substr(fn_get_dep_sortcode(p_depid), 1, 9);
    
    return l_result_value;
    
    EXCEPTION
--      WHEN NO_DATA_FOUND THEN
--      WHEN TOO_MANY_ROWS THEN
      WHEN OTHERS THEN    
          l_result_value := 0;
          return l_result_value;
      
/*    
    CASE (p_id)
    WHEN 1 THEN l_result_value := 'Центральная поликлиника';
    WHEN 3 THEN l_result_value := 'Валдайский многопрофильный медицинский центр';
    WHEN 5 THEN l_result_value := 'Поликлиника, филиал №2 (научно-лечебный центр)';
    WHEN 6 THEN l_result_value := 'Центр промышленной и морской медицины';
    WHEN 7 THEN l_result_value := 'Поликлиника №1';
    WHEN 8 THEN l_result_value := 'Поликлиника №3';
    WHEN 9 THEN l_result_value := 'Поликлиника №6';
    ELSE l_result_value := '';
    END CASE;
*/    
  END fn_get_id_lpu;
  
  
  /**
  * Отмена записи пациента
  *
  * @param int p_patient_id - Идентификатор пациента
  * @param int p_rnumb_id - Идентификатор талона
  * @returns:
  * int Код ошибки
  * varchar2 Текст ошибки
  */
  PROCEDURE cancel_appointment(p_patient_id IN NUMBER
                              ,p_rnumb_id   IN NUMBER
                              ,p_rc         IN OUT pkg_global.ref_cursor_type) AS

    l_result_rec         pkg_global.result_rtype;
    l_rc                 pkg_global.ref_cursor_type;
    l_visit_id           visit.keyid%TYPE;
    l_ps_qty             NUMBER;
    l_ps_plat            NUMBER;
    l_ps_inv             NUMBER;
    l_ps_dms             NUMBER;
    l_reason_id          lu.keyid%TYPE;
    l_reason_research_id lu.keyid%TYPE;
    e_error EXCEPTION;

    l_guid_send                   VARCHAR2(50);
    l_web_lk_email_info_talon     NUMBER;
    l_web_lk_email_reg_info_talon NUMBER;
    l_web_lk_email_reg            VARCHAR2(100);
    l_email_patient               VARCHAR2(100);
    l_to                          VARCHAR2(512);
    l_subject                     VARCHAR2(512);
    l_content_html                CLOB;
    l_doc_fio                     VARCHAR2(256);
    l_dat_rnumb                   DATE;
    l_text                        VARCHAR2(256);
    l_lastname                    VARCHAR2(50);
    l_firstname                   VARCHAR2(50);
    l_secondname                  VARCHAR2(50);
    l_doc_spec                    VARCHAR2(100);
    l_room                        VARCHAR2(100);
    l_lpu_address                 VARCHAR2(512);

  BEGIN
    --запись под пользователем с кодом WEBREC_PAWEB
    set_context_userid;

    SELECT r.visitid
          ,fn_get_lu_id_by_tag_code(326, 7) -- Пациент отменил прием самостоятельно через личный кабинет
      INTO l_visit_id
          ,l_reason_id
      FROM rnumb r
     WHERE r.keyid = p_rnumb_id;

    SELECT COUNT(*)
          ,nvl(MAX(CASE
                     WHEN nvl(ps.payservid, 0) <> 0 THEN
                      1
                     ELSE
                      0
                   END)
              ,0)
          ,nvl(MAX(nvl(ps.inv_status, 0)), 0)
          ,nvl(MAX(CASE
                     WHEN fn_get_agr_finance(ps.agrid) = 3
                          AND nvl(ps.confirm_dat
                                 ,(SELECT c.dat
                                    FROM confirm c
                                   WHERE c.link_id = ps.keyid
                                     AND c.link_tag = 1)) IS NOT NULL THEN
                      1
                     ELSE
                      0
                   END)
              ,0)
      INTO l_ps_qty
          ,l_ps_plat
          ,l_ps_inv
          ,l_ps_dms
      FROM patserv ps
     WHERE ps.visitid = l_visit_id
       AND nvl(l_visit_id, 0) <> 0;

    IF l_ps_qty = 0 THEN
      -- Если нет услуг, то отменяем прием
      p_visit.refuse_visit_add(p_visit_id                    => l_visit_id
                              ,p_rnumb_id                    => p_rnumb_id
                              ,p_status_release              => 1
                              ,p_status_service_modification => 2
                              ,p_reason_id                   => l_reason_id
                              ,p_note                        => ''
                              ,p_rc                          => p_rc);
    ELSIF l_ps_plat <> 0 THEN
      l_result_rec.error_text := 'К выбранному посещению, возможно, привязана оплаченная услуга. Просьба позвонить в ЛПУ для отмены или переноса приема.';
      RAISE e_error;
    ELSIF l_ps_inv <> 0 THEN
      l_result_rec.error_text := 'К выбранному посещению, возможно, привязана услуга, выставленная в оплату. Просьба позвонить в ЛПУ для отмены или переноса приема.';
      RAISE e_error;
    ELSIF l_ps_dms <> 0 THEN
      l_result_rec.error_text := 'К выбранному посещению, возможно, привязана согласованная по ДМС. Просьба позвонить в ЛПУ для отмены или переноса приема.';
      RAISE e_error;
    ELSE
      -- Отмена приема с услугой, если не оплачена, не выставдена в оплату и не согласована по ДМС
      p_visit.refuse_visit_add(p_visit_id                    => l_visit_id
                              ,p_rnumb_id                    => p_rnumb_id
                              ,p_status_release              => 1
                              ,p_status_service_modification => 1
                              ,p_reason_id                   => l_reason_id
                              ,p_note                        => ''
                              ,p_rc                          => p_rc);
      /* Отмена диагностического исследования */
      FOR r_research IN (SELECT r.id
                           FROM solution_diagnostic.research r
                               ,patserv ps
                          WHERE ps.research_id = r.id
                            AND ps.visitid = l_visit_id)
        LOOP
          l_reason_research_id := fn_get_lu_id_by_tag_code(406, 7); -- Пациент отменил прием самостоятельно через личный кабинет
          pkg_diagnostic.insert_or_update_refuse(p_createby    => NULL,
                                                 p_updateby    => NULL,
                                                 p_researchid  => r_research.id,
                                                 p_refusedocid => NULL,
                                                 p_refusecomm  => NULL,
                                                 p_refuseluid  => l_reason_research_id,
                                                 p_rc          => l_rc);
        END LOOP;
    END IF;

    FETCH p_rc
      INTO l_result_rec;

    -- Отправка почты
    l_web_lk_email_info_talon     := p_admin.fn_get_param_value_bool('WEB_LK_EMAIL_INFO_TALON');
    l_web_lk_email_reg_info_talon := p_admin.fn_get_param_value_bool('WEB_LK_EMAIL_REG_INFO_TALON');
    l_web_lk_email_reg            := p_admin.fn_get_param_value_text('WEB_LK_EMAIL_REG');

    -- Получаем данные по пациенту
    SELECT p.note
          ,g_make_first_upper(p.lastname) AS lastname -- Фамилия
          ,g_make_first_upper(p.firstname) AS firstname -- Имя
          ,g_make_first_upper(p.secondname) AS secondname -- Отчество
      INTO l_email_patient
          ,l_lastname
          ,l_firstname
          ,l_secondname
      FROM patient p
     WHERE p.keyid = p_patient_id;

    IF l_result_rec.error_code = pkg_global.err_no THEN
      -- Информация по талону p_rnumb_id
      IF ((l_web_lk_email_info_talon = 1) AND (length(l_email_patient) > 3))
         OR ((l_web_lk_email_reg_info_talon = 1) AND (length(l_web_lk_email_reg) > 3)) THEN
        SELECT fn_get_docdep_name_by_id(rn.docdepid)
              ,rn.dat
              ,nvl(rn.room, fn_get_lu_name(rn.room_id))
              ,fn_get_lu_name(dd.specid)
              ,pkg_protocol_universal.get_answer(get_dep_root_id_by_dep_id(dd.depid)
                                                ,'addres'
                                                ,'FORM_CONTENT_DEP_WEB'
                                                ,'text'
                                                ,'REGLPU')
          INTO l_doc_fio
              ,l_dat_rnumb
              ,l_room
              ,l_doc_spec
              ,l_lpu_address
          FROM solution_med.rnumb rn
              ,docdep             dd
         WHERE rn.keyid = p_rnumb_id
           AND rn.docdepid = dd.keyid;
        l_text := ' ' || l_doc_fio || ' на ' || to_char(l_dat_rnumb, 'dd.mm.yyyy') || ' в ' ||
                  to_char(l_dat_rnumb, 'hh24:mi');

      END IF;
      l_guid_send := pkg_ws_informer.get_guid();
      -- отправка клиенту
      IF (l_web_lk_email_info_talon = 1)
         AND (length(l_email_patient) > 3) THEN

        SELECT l_lastname || ' ' || l_firstname || ' <' || l_email_patient || '>'
              ,t.subject
              ,REPLACE(
               REPLACE(
               REPLACE(
               REPLACE(
               REPLACE(
               REPLACE(
               REPLACE(
               REPLACE(
               REPLACE(
               REPLACE(
               REPLACE(t.text, '[p_FIO]', l_lastname || ' ' || l_firstname || ' ' || l_secondname)
                             , '[p_SPEC]', l_doc_spec)
                             , '[p_DOC_FIO]', l_doc_fio)
                             , '[p_DAT]', to_char(l_dat_rnumb, 'dd.mm.yyyy'))
                             , '[p_TIME]', to_char(l_dat_rnumb, 'hh24:mi'))
                             , '[p_ROOM]', nvl(l_room, 'Не указан'))
                             , '[p_LPU_ADDRESS]', l_lpu_address)
                             , '[p_EMAIL_URL_LOGO]', c_email_url_logo)
                             , '[p_EMAIL_URL_VK]', c_email_url_vk)
                             , '[p_EMAIL_URL_YOUTUBE]', c_email_url_youtube)
                             , '[p_EMAIL_INFO]', c_email_info)
          INTO l_to
              ,l_subject
              ,l_content_html
          FROM inetuser.WS_HTML_TEMPLATE_TEXT t
         WHERE t.code = 'WEB_LK_cancel_appointment';

        pkg_ws_informer.send_email_html_sync(p_guid         => l_guid_send
                                            ,p_address_to   => l_to
                                            ,p_subject      => l_subject
                                            ,p_content_html => l_content_html
                                            ,p_rc           => p_rc);
      END IF;
      -- Отправка в регистратуру
      IF (l_web_lk_email_reg_info_talon = 1)
         AND (length(l_web_lk_email_reg) > 3) THEN
        l_content_html := '<html><head><meta http-equiv="content-type" content="text/html; charset=UTF-8"></head>
          <body>
          <div><p>Отмена записи на прием к врачу:</p>
          <span>Клиент: ' || l_lastname || ' ' || l_firstname || ' ' || l_secondname ||
                          ', отменил запись из личного кабинета к врачу - ' || l_text || '</span></div>
          </body>
          </html>';

        pkg_ws_informer.send_email_html_sync(p_guid         => l_guid_send
                                            ,p_address_to   => 'Регистратура <' || l_web_lk_email_reg || '>'
                                            ,p_subject      => 'Отмена записи к врачу'
                                            ,p_content_html => l_content_html
                                            ,p_rc           => p_rc);
      END IF;
    END IF;

    OPEN p_rc FOR
      SELECT l_result_rec.error_code AS err_code
            ,l_result_rec.error_text AS err_text
            ,'' AS guid
        FROM dual;

  EXCEPTION
    WHEN e_error THEN
      OPEN p_rc FOR
        SELECT pkg_global.err_crit AS err_code
              ,l_result_rec.error_text AS err_text
              ,'' AS guid
          FROM dual;
    WHEN OTHERS THEN
      dbms_output.put_line(SQLERRM);
      OPEN p_rc FOR
        SELECT pkg_global.err_crit AS err_code
              ,'Произошла ошибка' AS err_text
              ,'' AS guid
          FROM dual;
  END cancel_appointment;

  /**
  * Блокировка талона
  *
  * @param int p_rnumb_id - идентификатор талона
  * @returns:
  * int Код ошибки
  * varchar2 Текст ошибки
  */
  PROCEDURE set_numb_blstatus(p_rnumb_id   IN NUMBER
                             ,p_patient_id IN NUMBER
                             ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
    l_blstatus        NUMBER;
    l_edit_now_status NUMBER;
    l_result_rec      pkg_global.result_rtype;
    l_edit_res        NUMBER;
    l_updateby        NUMBER;
    l_rc              pkg_global.ref_cursor_type;
    l_stacid          NUMBER;
    polis4Count       NUMBER; -- количество полисов - ОМС
    polis5Count       NUMBER; -- количество полисов - ДМС
    polisOMSCount       NUMBER; -- количество полисов - только полис ОМС
  BEGIN

    SELECT nvl(blstatus, 0)
          ,nvl(edit_now_status, 0)
          ,nvl(updateby, 0)
          ,nvl(fn_get_lu_code(stacid), 0)
      INTO l_blstatus
          ,l_edit_now_status
          ,l_updateby
          ,l_stacid
      FROM rnumb
     WHERE keyid = p_rnumb_id;

-- l_stacid  (27714261 - ОМС = 7)

    select count(*) as col
    INTO polis5Count
     FROM agr    a
            ,police p
       WHERE a.keyid = p.agrid
         AND p.patientid = p_patient_id
         and p.enddat > sysdate
         and a.enddat > sysdate
         and fn_get_agr_whopays_code(a.keyid) = 5;-- ОМС
    select count(*) as col
    INTO polis4Count
     FROM agr    a
            ,police p
       WHERE a.keyid = p.agrid
         AND p.patientid = p_patient_id
         and p.enddat > sysdate
         and a.enddat > sysdate
         and fn_get_agr_whopays_code(a.keyid) = 4;--ДМС

    select count(*) as col
    INTO polisOMSCount
     FROM agr    a
            ,police p
       WHERE a.keyid = p.agrid
         AND p.patientid = p_patient_id
         and p.enddat > sysdate
         and fn_get_agr_whopays_code(a.keyid) = 5;-- ОМС

/* Проверка на ОМС **/
/*    IF (l_stacid = 940) AND (polis5Count>0) THEN
        l_result_rec.error_code := pkg_global.err_crit;
        l_result_rec.error_text := 'Вам запрещено записываться';
    END IF;
*//* Проверка на ДМС**/
/*    IF (l_stacid = 941) AND (polis4Count>0) THEN
        l_result_rec.error_code := pkg_global.err_crit;
        l_result_rec.error_text := 'Вам запрещено записываться';
    END IF;
*//* Проверка на диспансеризацию**/
/*    IF (l_stacid = 942) AND (polis5Count>0) THEN
        l_result_rec.error_code := pkg_global.err_crit;
        l_result_rec.error_text := 'Вам запрещено записываться';
    END IF;
*/
--    IF l_blstatus =8 -- тест
    IF l_blstatus = 1
       AND (l_edit_now_status = 0 OR l_updateby != gsp_get_user_id()) THEN
      set_numb_edit_now_status(p_rnumb_id, 1, l_rc);
      FETCH l_rc
        INTO l_edit_res;
      IF l_edit_res = 0 THEN
        l_result_rec.error_code := pkg_global.err_crit;
        l_result_rec.error_text := 'Выбранное время в данный момент редактируется';
      END IF;
    ELSE
      l_result_rec.error_code := pkg_global.err_crit;
      l_result_rec.error_text := 'Номерок уже занят';
    END IF;

    OPEN p_rc FOR
      SELECT l_result_rec.error_code AS err_code
            ,l_result_rec.error_text AS err_text
        FROM dual;

  EXCEPTION
    WHEN OTHERS THEN
      OPEN p_rc FOR
        SELECT pkg_global.err_crit AS err_code
              ,'Произошла ошибка ' AS err_text
          FROM dual;
  END set_numb_blstatus;

  /**
  * РАЗБлокировка талона
  *
  * @param int p_rnumb_id - идентификатор талона
  * @returns:
  * int Код ошибки
  * varchar2 Текст ошибки
  */
  PROCEDURE set_numb_unlock_status(p_rnumb_id IN NUMBER
                                  ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
    l_blstatus        NUMBER;
    l_edit_now_status NUMBER;
    l_patient_id      NUMBER;
    l_rootid          NUMBER;
  BEGIN

    SELECT MAX(patientid)
          ,MAX(blstatus)
          ,MAX(edit_now_status)
          ,MAX(root_id)
      INTO l_patient_id
          ,l_blstatus
          ,l_edit_now_status
          ,l_rootid
      FROM rnumb
     WHERE keyid = p_rnumb_id;

    IF nvl(l_patient_id, 0) = 0 THEN

      IF l_rootid IS NOT NULL THEN
        --удаляем, если был интервальным
        DELETE FROM rnumb
         WHERE keyid = p_rnumb_id;
      ELSE
        UPDATE rnumb r
           SET edit_now_status = 0
              ,blstatus        = 1
         WHERE r.keyid = p_rnumb_id;
      END IF;

      OPEN p_rc FOR
        SELECT pkg_global.err_no AS err_code
              ,'' AS err_text
              ,'' AS guid
          FROM dual;
    ELSE
      OPEN p_rc FOR
        SELECT pkg_global.err_crit AS err_code
              ,'На номерке уже есть записанный пациент' AS err_text
              ,'' AS guid
          FROM dual;
    END IF;

    COMMIT;

  EXCEPTION
    WHEN OTHERS THEN
      OPEN p_rc FOR
        SELECT pkg_global.err_crit AS err_code
              ,'Произошла ошибка ' AS err_text
              ,'' AS guid
          FROM dual;
  END set_numb_unlock_status;
  
  /**
  * Запись пациента на талон
  *
  * p_patient_id - Идентификатор пациента
  * p_rnumb_id - Идентификатор талона
  * p_srv_ids = Идентификаторы услуг
  * @returns:
  * int Код ошибки
  * varchar2 Текст ошибки
  */
  PROCEDURE patient_appointment(p_patient_id IN NUMBER
                               ,p_rnumb_id   IN NUMBER
                               ,p_srv_ids    IN VARCHAR2
                               ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
    l_check_double_talon NUMBER := nvl(p_admin.fn_get_param_value_bool('601005'), 0);
    l_docdepid           NUMBER;
    l_dat                DATE;
    l_check              NUMBER;
    l_result_rec         pkg_global.result_rtype;
    l_pat_row            solution_med.patient%ROWTYPE;
    l_rc                 pkg_global.ref_cursor_type;
    l_agr_id             NUMBER := p_admin.fn_get_param_value_linkid('506749'); -- Онлайн-оплата. Шифр для проведения онлайн платежей.
    l_cr_srv             NUMBER := p_admin.fn_get_param_value_number('506758'); -- Создавать услуги при подтверждении записи на приём
    e_error EXCEPTION;

    l_guid_send                   VARCHAR2(50);
    l_web_lk_email_info_talon     NUMBER;
    l_web_lk_email_reg_info_talon NUMBER;
    l_web_lk_email_reg            VARCHAR2(100);
    l_email_patient               VARCHAR2(100);
    l_to                          VARCHAR2(512);
    l_subject                     VARCHAR2(512);
    l_content_html                CLOB;
    l_doc_fio                     VARCHAR2(256);
    l_dat_rnumb                   DATE;
    l_text                        VARCHAR2(256);
    l_lastname                    VARCHAR2(50);
    l_firstname                   VARCHAR2(50);
    l_secondname                  VARCHAR2(50);
    l_doc_spec                    VARCHAR2(100);
    l_room                        VARCHAR2(100);
    l_lpu_address                 VARCHAR2(512);
    l_serv                        CLOB; -- информация по услуге
    l_time_left                   VARCHAR2(1000); -- оставшееся время для оплаты

    l_is_online_pay       NUMBER := 0;
    l_is_telemed          NUMBER := 0;
    l_is_create_srvs      NUMBER := 0;
    l_is_create_pay_order NUMBER := 0;

    l_count_agr NUMBER := 0;
    l_count_stacid_rnumb NUMBER := 0;
    l_count_agr28055 NUMBER := 0;
    l_28055_doc_id NUMBER := 0;
    l_28055_count_dep NUMBER := 0;
    l_rc_28055 pkg_global.ref_cursor_type;
    l_age          NUMBER;
    l_count_age    NUMBER;
  BEGIN

    --запись под пользователем с кодом WEBREC_PAWEB
    set_context_userid;
    -- Получаем возраст пациента
      SELECT gsp_get_age_full_years(p.birthdate, SYSDATE)
        INTO l_age
        FROM patient p
       WHERE p.keyid = p_patient_id;

    SELECT dat
          ,docdepid
      INTO l_dat
          ,l_docdepid
      FROM rnumb
     WHERE keyid = p_rnumb_id;

    SELECT COUNT(*)
      INTO l_check
      FROM rnumb r
     WHERE r.keyid = p_rnumb_id
       AND nvl(r.patientid, 0) = 0;

    IF l_check != 1 THEN
      l_result_rec.error_code := pkg_global.err_crit;
      l_result_rec.error_text := 'На номерке уже есть записанный пациент';
      RAISE e_error;
    END IF;

-- Проверка на децкие номерки и возраст
     select count(*)
     into l_count_age
     from rnumb r
     where r.keyid = p_rnumb_id
     and r.stacid = 90718498; -- метка ЛК Децкий

   IF l_age > 17 THEN
     IF l_count_age>0 THEN
      l_result_rec.error_code := pkg_global.err_crit;
      l_result_rec.error_text := 'Вы пытаетесь записаться в разделе "Педиатрия", для пациентов в возрасте до 18 лет';
      RAISE e_error;
     END IF;
   ELSE
     IF l_count_age=0 THEN  -- не децкий номерок
      l_result_rec.error_code := pkg_global.err_crit;
      l_result_rec.error_text := 'Запись пациентов до 18 лет, доступна в разделе "Педиатрия"';
      RAISE e_error;
     END IF;
   END IF;

-- Проверка на шифры
    select count(a.keyid) --количество шифров
    into l_count_agr
    FROM agr a
        ,agrpat d
    WHERE a.keyid = d.agrid
      AND d.patientid = p_patient_id
--      AND a.typ in ('9.530.7', '9.531.7', '9.532.7');
      AND a.typ in ('9.531.71', '9.532.71');

-- Проверка на шифры 28.05.5
    select count(a.keyid) --количество шифров
    into l_count_agr28055
    FROM agr a
        ,agrpat d
    WHERE a.keyid = d.agrid
      AND d.patientid = p_patient_id
      AND a.typ in ('28.05.5');
/*
      select count(r.keyid)
      into l_count_stacid_rnumb
      from rnumb r
      where r.keyid = p_rnumb_id
      and r.stacid = 90717837;

    IF l_count_stacid_rnumb = 1 THEN
      IF l_count_agr = 0 THEN
        l_result_rec.error_code := pkg_global.err_crit;
        l_result_rec.error_text := 'Запись не возможна, обратитесь в регистратуру.';
        RAISE e_error;
      END IF;
    END IF;
*/
---

    IF l_check_double_talon = 1 THEN

      SELECT COUNT(*) /*nkk*/
        INTO l_check
        FROM rnumb r
       WHERE r.rdayid = (SELECT rdayid
                           FROM rnumb
                          WHERE keyid = p_rnumb_id)
         AND r.patientid = p_patient_id;

      IF l_check > 0 THEN
        l_result_rec.error_code := pkg_global.err_crit;
        l_result_rec.error_text := 'Повторная запись к одному и тому же специалисту в один день запрещена';
        RAISE e_error;
      END IF;
    END IF;

    SELECT *
      INTO l_pat_row
      FROM patient p
     WHERE p.keyid = p_patient_id;


   select d.keyid
   INTO l_28055_doc_id
   FROM docdep dd
       ,doctor d
   WHERE d.keyid = dd.docid
     and dd.keyid in (select r.docdepid from rnumb r where r.keyid = p_rnumb_id);

-- Доктор принадлежит департаменту: Амбулаторные, Филиал №2
   select count(dd.depid)
   INTO l_28055_count_dep
   FROM v_docdep dd
   where dd.docid = l_28055_doc_id
   and dd.depid in (1,2239)
   and dd.status =1;

    IF l_28055_count_dep>0 THEN
    -- Проверка на существование шифра  !!!
    IF l_count_agr28055=0 THEN -- Создание шифра
      p_police.pat_create_agrpat_with_check(p_patient_id , 245, l_rc_28055);
       FETCH l_rc_28055
        INTO l_result_rec.identity
            ,l_result_rec.error_text
            ,l_result_rec.error_code;
       IF l_result_rec.error_code <> pkg_global.err_no  THEN
        RAISE e_error;
      END IF;
    END IF;

      reg_create_visit_new_agrpol(l_pat_row.keyid, p_rnumb_id, 245, l_pat_row.policeid, l_rc);
    ELSE
      reg_create_visit_new_agrpol(l_pat_row.keyid, p_rnumb_id, l_pat_row.agrid, l_pat_row.policeid, l_rc);
    END IF;

    FETCH l_rc
      INTO l_result_rec.identity
          ,l_result_rec.error_text
          ,l_result_rec.error_code;
    IF l_result_rec.identity <= 0 THEN
      RAISE e_error;
    END IF;

    UPDATE rnumb
       SET edit_now_status = 0
     WHERE keyid = p_rnumb_id;

    UPDATE visit v
       SET num = pkg_global.get_next_value('s_new_talon_number')
     WHERE v.keyid = l_result_rec.identity;

    IF l_result_rec.error_code = pkg_global.err_no THEN
      l_result_rec.error_text := 'Успешно';
    END IF;

    rnumb_attrs(p_rnumb_id, p_srv_ids, p_rc);
    FETCH p_rc
      INTO l_is_online_pay
          ,l_is_telemed
          ,l_is_create_srvs
          ,l_is_create_pay_order;

    -- Cоздание услуги без оплаты
    IF l_is_create_srvs = 1 AND nvl(l_is_online_pay, 0) = 0 AND l_cr_srv = 1 THEN
      create_rnumb_srvs(p_patient_id, p_rnumb_id, p_srv_ids, l_rc);
      FETCH l_rc
        INTO l_result_rec.error_code
            ,l_result_rec.error_text
            ,l_result_rec.result_code;
      IF l_result_rec.error_code = 2 THEN
        RAISE e_error;
      END IF;
    END IF;

    IF l_result_rec.error_code = pkg_global.err_no THEN
      -- Отправка почты
      l_web_lk_email_info_talon     := p_admin.fn_get_param_value_bool('WEB_LK_EMAIL_INFO_TALON');
      l_web_lk_email_reg_info_talon := p_admin.fn_get_param_value_bool('WEB_LK_EMAIL_REG_INFO_TALON');
      l_web_lk_email_reg            := p_admin.fn_get_param_value_text('WEB_LK_EMAIL_REG');

      -- Получаем данные по пациенту
      SELECT p.note
            ,g_make_first_upper(p.lastname) AS lastname -- Фамилия
            ,g_make_first_upper(p.firstname) AS firstname -- Имя
            ,g_make_first_upper(p.secondname) AS secondname -- Отчество
        INTO l_email_patient
            ,l_lastname
            ,l_firstname
            ,l_secondname
        FROM patient p
       WHERE p.keyid = p_patient_id;

      -- Информация по талону p_rnumb_id
      IF ((l_web_lk_email_info_talon = 1) AND (length(l_email_patient) > 3))
         OR ((l_web_lk_email_reg_info_talon = 1) AND (length(l_web_lk_email_reg) > 3)) THEN
        SELECT fn_get_docdep_name_by_id(rn.docdepid)
              ,rn.dat
              ,nvl(rn.room, fn_get_lu_name(rn.room_id))
              ,fn_get_lu_name(dd.specid)
              ,pkg_protocol_universal.get_answer(get_dep_root_id_by_dep_id(dd.depid)
                                                ,'addres'
                                                ,'FORM_CONTENT_DEP_WEB'
                                                ,'text'
                                                ,'REGLPU')
          INTO l_doc_fio
              ,l_dat_rnumb
              ,l_room
              ,l_doc_spec
              ,l_lpu_address
          FROM solution_med.rnumb rn
              ,docdep             dd
         WHERE rn.keyid = p_rnumb_id
           AND rn.docdepid = dd.keyid;
        l_text := ' ' || l_doc_fio || ' на ' || to_char(l_dat_rnumb, 'dd.mm.yyyy') || ' в ' ||
                  to_char(l_dat_rnumb, 'hh24:mi');

      END IF;
      l_guid_send := pkg_ws_informer.get_guid();

      -- отправка клиенту
      IF (l_web_lk_email_info_talon = 1)
         AND (length(l_email_patient) > 3) THEN

        IF l_is_online_pay = 1 THEN
          -- запись с услугой, обязательной к оплате
          SELECT clob_agg(table_clob_list(sd.text || '<br>' || 'Стоимость: ' ||
                                          to_char(gsp_get_price(l_agr_id, sd.keyid, gsp_date_2char(SYSDATE)) *
                                                  gsp_get_discount(l_agr_id, sd.keyid, gsp_date_2char(SYSDATE))
                                                 ,'fm9999G999G999G999G990D00'
                                                 ,'NLS_NUMERIC_CHARACTERS = '', ''') || ' руб.'
                                         ,'<br>'))
            INTO l_serv
            FROM srvdep sd
           WHERE sd.keyid IN (SELECT *
                                FROM TABLE(p_utils.text_to_table(p_srv_ids)));

          l_time_left := p_utils.date_to_russian(SYSDATE) || '<br>' || 'в ' ||
                         to_char(SYSDATE + g_countmins / 24 / 60, 'hh24:mi') || '<br>' ||
                         'Если услуга не будет оплачена к указанному времени, запись к врачу будет отменена автоматически';

          SELECT l_lastname || ' ' || l_firstname || ' <' || l_email_patient || '>'
                ,t.subject
                ,REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(t.text, '[p_FIO]', l_lastname || ' ' || l_firstname || ' ' || l_secondname)
                               , '[p_SPEC]', l_doc_spec)
                               , '[p_DOC_FIO]', l_doc_fio)
                               , '[p_DAT]', to_char(l_dat_rnumb, 'dd.mm.yyyy'))
                               , '[p_TIME]', to_char(l_dat_rnumb, 'hh24:mi'))
                               , '[p_ROOM]', nvl(l_room, 'Не указан'))
                               , '[p_LPU_ADDRESS]', l_lpu_address)
                               , '[p_SERV]', l_serv)
                               , '[p_TIME_LEFT]', l_time_left)
                               , '[p_EMAIL_URL_LOGO]', c_email_url_logo)
                               , '[p_EMAIL_URL_VK]', c_email_url_vk)
                               , '[p_EMAIL_URL_YOUTUBE]', c_email_url_youtube)
                               , '[p_EMAIL_INFO]', c_email_info)
            INTO l_to
                ,l_subject
                ,l_content_html
            FROM inetuser.WS_HTML_TEMPLATE_TEXT t
           WHERE t.code = 'WEB_LK_pat_appointment_pay';
        ELSE
          -- обычная запись
          SELECT l_lastname || ' ' || l_firstname || ' <' || l_email_patient || '>'
                ,t.subject
                ,REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(
                 REPLACE(t.text, '[p_FIO]', l_lastname || ' ' || l_firstname || ' ' || l_secondname)
                               , '[p_SPEC]', l_doc_spec)
                               , '[p_DOC_FIO]', l_doc_fio)
                               , '[p_DAT]', to_char(l_dat_rnumb, 'dd.mm.yyyy'))
                               , '[p_TIME]', to_char(l_dat_rnumb, 'hh24:mi'))
                               , '[p_ROOM]', nvl(l_room, 'Не указан'))
                               , '[p_LPU_ADDRESS]', l_lpu_address)
                               , '[p_EMAIL_URL_LOGO]', c_email_url_logo)
                               , '[p_EMAIL_URL_VK]', c_email_url_vk)
                               , '[p_EMAIL_URL_YOUTUBE]', c_email_url_youtube)
                               , '[p_EMAIL_INFO]', c_email_info)
            INTO l_to
                ,l_subject
                ,l_content_html
            FROM inetuser.WS_HTML_TEMPLATE_TEXT t
           WHERE t.code = 'WEB_LK_pat_appointment';
        END IF;

        pkg_ws_informer.send_email_html_sync(p_guid         => l_guid_send
                                            ,p_address_to   => l_to
                                            ,p_subject      => l_subject
                                            ,p_content_html => l_content_html
                                            ,p_rc           => p_rc);
      END IF;
      -- Отправка в регистратуру
      IF (l_web_lk_email_reg_info_talon = 1)
         AND (length(l_web_lk_email_reg) > 3) THEN
        l_content_html := '<html><head><meta http-equiv="content-type" content="text/html; charset=UTF-8"></head>
          <body>
          <div><p>Запись на прием к врачу:</p>
          <span>Клиент: ' || l_lastname || ' ' || l_firstname || ' ' || l_secondname ||
                          ', записался из личного кабинета к врачу - ' || l_text || '</span></div>
          </body>
          </html>';

        pkg_ws_informer.send_email_html_sync(p_guid         => l_guid_send
                                            ,p_address_to   => 'Регистратура <' || l_web_lk_email_reg || '>'
                                            ,p_subject      => 'Запись к врачу'
                                            ,p_content_html => l_content_html
                                            ,p_rc           => p_rc);
      END IF;
    END IF;

    OPEN p_rc FOR
      SELECT l_result_rec.error_code AS err_code
            ,l_result_rec.error_text AS err_text
            ,'' AS guid
        FROM dual;
  EXCEPTION
    WHEN e_error THEN
      OPEN p_rc FOR
        SELECT l_result_rec.error_code AS err_code
              ,l_result_rec.error_text AS err_text
              ,'' AS guid
          FROM dual;
    WHEN OTHERS THEN
      OPEN p_rc FOR
        SELECT pkg_global.err_crit AS err_code
              ,'Упc' AS err_text
              ,'' AS guid
          FROM dual;
  END patient_appointment;
  

  /**
  * атрибуты номерка, запускается после записи на прием
  *
  * p_rnumb_id - Идентификатор талона
  * p_srv_ids = Идентификаторы услуг
  * @returns:
  * int is_online_pay        - 0 - можно оплатить онлайн и в ЛПУ, 1 - обязательная оплата онлайн, null - нет выбора онлайн-оплаты
  * int is_telemed           - 0 - обычный номерок, 1 - телеконференция
  * int is_create_srvs       - 0 - не нужно сразу создавать услуги, 1 - нужно сразу создавать услуги на номерке
  * int is_create_pay_order  - 0 - не нужно сразу создавать заказ для оплаты, 1 - нужно сразу создавать заказ для оплаты
  */
  PROCEDURE rnumb_attrs(p_rnumb_id IN NUMBER
                       ,p_srv_ids  IN VARCHAR2
                       ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
    l_stac_code NUMBER;
    l_srv_code  srvdep.code%TYPE := nvl(p_admin.fn_get_param_value_text('506748'), '-1'); -- код услуги "без услуг"
    l_agr_id    NUMBER;
    l_dat       DATE;

    l_is_online_pay       NUMBER := 0;
    l_is_telemed          NUMBER := 0;
    l_is_create_srvs      NUMBER := 0;
    l_is_create_pay_order NUMBER := 0;

  BEGIN
    IF p_srv_ids IS NOT NULL THEN

      l_is_create_srvs := 1;

      SELECT l.code, v.agrid, r.dat
        INTO l_stac_code, l_agr_id, l_dat
        FROM rnumb r
        JOIN visit v
          ON v.keyid = r.visitid
        LEFT JOIN lu l
          ON l.keyid = r.stacid
       WHERE r.keyid = p_rnumb_id;

      FOR rc IN (SELECT sd.keyid AS srv_id
                       ,sd.tag
                       ,nvl(sd.code, '0') code
                       ,gsp_get_price(l_agr_id, sd.keyid, gsp_date_2char(l_dat)) *
                        gsp_get_discount(l_agr_id, sd.keyid, gsp_date_2char(l_dat)) price
                   FROM srvdep sd
                  WHERE sd.keyid MEMBER OF p_collections.string_to_table_of_id(nvl(p_srv_ids, '0')))
      LOOP
        l_is_online_pay := greatest(l_is_online_pay, fn_is_online_pay(rc.srv_id));
        -- Если "посещение без услуг", то услугу не создаем
        IF rc.code = l_srv_code THEN
          l_is_online_pay  := NULL;
          l_is_create_srvs := 0;
          -- если цена 0, то услугу создаем, но без выбора онлайн-оплаты
        ELSIF rc.price = 0 THEN
          l_is_online_pay  := 0;
        ELSIF rc.tag = 104
              AND l_stac_code = 913 THEN
          -- телемедицина
          l_is_telemed := 1;
          l_is_create_pay_order := 1;
        END IF;

        -- Если обязательно к онлайн-оплате, то нужно создавать услуги и платеж
/* 24-08-26 */
        IF l_is_online_pay = 1 THEN
          l_is_create_pay_order := 1;
        END IF;
/*        */
      END LOOP;
    ELSE
      l_is_online_pay := NULL;
    END IF;

    OPEN p_rc FOR
      SELECT l_is_online_pay       AS is_online_pay
            ,l_is_telemed          AS is_telemed
            ,l_is_create_srvs      AS is_create_srvs
            ,l_is_create_pay_order AS is_create_pay_order
        FROM dual;

  EXCEPTION
    WHEN OTHERS THEN
      OPEN p_rc FOR
        SELECT l_is_online_pay       AS is_online_pay
              ,l_is_telemed          AS is_telemed
              ,l_is_create_srvs      AS is_create_srvs
              ,l_is_create_pay_order AS is_create_pay_order
          FROM dual;
  END rnumb_attrs;
  
  /**
  * Создание услуг
  *
  * p_patient_id - Идентификатор пациента
  * p_rnumb_id - Идентификатор талона
  * p_srv_ids = Идентификаторы услуг
  * @returns:
  * int Код ошибки
  * varchar2 Текст ошибки
  */
  PROCEDURE create_rnumb_srvs(p_patient_id IN NUMBER
                             ,p_rnumb_id   IN NUMBER
                             ,p_srv_ids    IN VARCHAR2
                             ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
    l_docdep_id  NUMBER;
    l_visit_id   NUMBER;
    l_dat        DATE;
    l_dd_sendid  NUMBER;
    l_result_rec pkg_global.result_rtype;
    l_pat_row    solution_med.patient%ROWTYPE;
    l_rc         pkg_services.t_create_patserv_rtype;
    l_agr_id     NUMBER;
    e_error      EXCEPTION;

  BEGIN

    BEGIN
      SELECT dd.keyid
        INTO l_dd_sendid
        FROM docdep dd
       WHERE dd.code = 'WEBSELFREC';
    EXCEPTION
      WHEN no_data_found THEN
        l_dd_sendid := NULL;
    END;

    SELECT dat
          ,docdepid
          ,visitid
      INTO l_dat
          ,l_docdep_id
          ,l_visit_id
      FROM rnumb
     WHERE keyid = p_rnumb_id;

    SELECT *
      INTO l_pat_row
      FROM patient p
     WHERE p.keyid = p_patient_id;

    FOR rc IN (SELECT sd.keyid AS srv_id
                     ,pkg_services.fn_get_default_place_id(sd.keyid) place_id
                 FROM srvdep sd
                WHERE sd.keyid MEMBER OF p_collections.string_to_table_of_id(nvl(p_srv_ids, '0')))
    LOOP

      pkg_web_account_unique.get_agr_for_online_pay(p_patient_id, rc.srv_id, p_rc);
      FETCH p_rc
        INTO l_agr_id;
      pkg_services.hsp_create_patserv_complex(p_patient_id
                                             ,rc.srv_id
                                             ,l_visit_id
                                             ,nvl(l_agr_id, p_admin.fn_get_param_value_linkid('50'))
                                             ,0
                                             ,NULL
                                             ,1.000000000000000
                                             ,l_dat
                                             ,NULL
                                             ,''
                                             ,l_dd_sendid
                                             ,l_docdep_id
                                             ,NULL
                                             ,NULL
                                             ,1
                                             ,''
                                             ,nvl(rc.place_id, fn_get_dep_keyid_by_docdepid(l_docdep_id))
                                             ,NULL
                                             ,NULL
                                             ,NULL
                                             ,NULL
                                             ,NULL
                                             ,NULL,null,null
                                             ,p_rc);

      FETCH p_rc
        INTO l_rc;
      l_result_rec.identity   := l_rc.identity;
      l_result_rec.error_code := l_rc.error_code;
      l_result_rec.error_text := l_rc.error_text;

      IF l_result_rec.error_code = pkg_global.err_no THEN
        l_result_rec.error_text := 'Успешно';
      ELSE
        RAISE e_error;
      END IF;
      --      dbms_output.put_line(l_result_rec.error_text);
    END LOOP;

    OPEN p_rc FOR
      SELECT l_result_rec.error_code AS err_code
            ,l_result_rec.error_text AS err_text
            ,'' AS guid
        FROM dual;
  EXCEPTION
    WHEN e_error THEN
      OPEN p_rc FOR
        SELECT l_result_rec.error_code AS err_code
              ,l_result_rec.error_text AS err_text
              ,'' AS guid
          FROM dual;
    WHEN OTHERS THEN
      OPEN p_rc FOR
        SELECT pkg_global.err_crit AS err_code
              ,'Не удалось создать услуги!' AS err_text
              ,'' AS guid
          FROM dual;
  END create_rnumb_srvs;
  
  /**
  * Создание платежа после записи на номерок
  *
  * p_rnumb_id - Идентификатор талона
  * @returns:
  * int Идентификатор платежа
  */
  PROCEDURE create_payment_by_rnumb(p_patient_id IN NUMBER
                                   ,p_rnumb_id   IN NUMBER
                                   ,p_srv_ids    IN VARCHAR2
                                   ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
    l_docdepid   docdep.keyid%TYPE;
    l_stac_rnumb lu.code%TYPE;
    l_visitid    visit.keyid%TYPE;
    l_dat        DATE;
    l_result_rec pkg_global.result_rtype;
    l_price      price_list.price%TYPE;
    l_amount     NUMBER := 0;
    l_patient_id patient.keyid%TYPE;

    l_payment_total_tmp_id pkg_global.result_rtype;
    l_payment_total_new_id pkg_global.result_rtype;
    l_payserv_id           pkg_global.result_rtype;

    p_rc_tmp                pkg_global.ref_cursor_type;
    p_rc_tmp_payserv        pkg_global.ref_cursor_type;
    p_rc_real_payment_total pkg_global.ref_cursor_type;

    e_error EXCEPTION;
  BEGIN

    SELECT r.docdepid
          ,fn_get_lu_code(r.stacid)
          ,v.keyid
          ,r.dat
          ,r.patientid
      INTO l_docdepid
          ,l_stac_rnumb
          ,l_visitid
          ,l_dat
          ,l_patient_id
      FROM rnumb r
          ,visit v
     WHERE r.keyid = p_rnumb_id
       AND r.visitid = v.keyid
       AND r.patientid = p_patient_id;

    gsp_set_context('USER_ID', pkg_global.get_constant_value('pkg_ws_pay.c_online_userid')); -- Пользователь "Онлайн-платежи"

    -- Создание услуг для оплаты
    create_rnumb_srvs(p_patient_id, p_rnumb_id, p_srv_ids, p_rc);
    FETCH p_rc
      INTO l_result_rec.error_code
          ,l_result_rec.error_text
          ,l_result_rec.result_code;
    IF l_result_rec.error_code = 2 THEN
      RAISE e_error;
    END IF;

    FOR l_patserv_rec IN (SELECT ps.*
                            FROM patserv ps
                           WHERE ps.visitid = l_visitid
                             AND nvl(ps.srv_status, 0) = 0)
    LOOP
      SELECT gsp_get_price(l_patserv_rec.agrid, l_patserv_rec.srvdepid, gsp_date_2char(SYSDATE)) *
             gsp_get_discount(l_patserv_rec.agrid, l_patserv_rec.srvdepid, gsp_date_2char(SYSDATE))
        INTO l_price
        FROM dual;

      l_amount := l_amount + l_price;
      p_pay_2.save_tmp_payment_total(p_payment_total_id    => nvl(l_payment_total_new_id.identity, -1)
                                    ,p_deleted_payserv_ids => ''
                                    ,p_patient_id          => l_patient_id
                                    ,p_agrid               => l_patserv_rec.agrid
                                    ,p_police_id           => ''
                                    ,p_type_code           => 11
                                    ,p_link_tag            => ''
                                    ,p_link_id             => ''
                                    ,p_pay_oday_id         => ''
                                    ,p_bring_persid        => ''
                                    ,p_customer_id         => ''
                                    ,p_dep_id              => ''
                                    ,p_check_code          => ''
                                    ,p_text                => 'Оплата телемедицины/онлайн-консультации'
                                    ,p_transfer_type_id    => ''
                                    ,p_rc                  => p_rc_tmp);
      /*формирование услуги*/
      FETCH p_rc_tmp
        INTO l_payment_total_tmp_id;
      p_pay_2.payserv_save(p_patient_id       => l_patient_id
                          ,p_patserv_id       => l_patserv_rec.keyid
                          ,p_payment_total_id => l_payment_total_tmp_id.identity
                          ,p_srvdep_id        => l_patserv_rec.srvdepid
                          ,p_docdep_id        => nvl(l_patserv_rec.docid_exec, l_patserv_rec.docdepid)
                          ,p_price            => l_price
                          ,p_amount           => l_price
                          ,p_discount         => 0
                          ,p_qty              => 1
                          ,p_perc             => 1
                          ,p_dat              => l_dat
                          ,p_agr_id           => l_patserv_rec.agrid
                          ,p_placeid          => l_patserv_rec.placeid
                          ,p_cito_stat        => 0
                          ,p_price_lu_id      => 0
                          ,p_rc               => p_rc_tmp_payserv);

      FETCH p_rc_tmp_payserv
        INTO l_payserv_id;
      /*формирование реального платежа из временного*/
      p_pay_2.create_payment_total_from_tmp(
                                            /*p_tmp_payment_total_id =>*/l_payment_total_tmp_id.identity
                                           ,
                                            /*p_paytype_code         => */NULL
                                           ,
                                            /*p_pay_oday_id          => */NULL
                                           ,
                                            /*p_lpu_id               => */NULL
                                           ,
                                            /*p_is_moneyback         => */0
                                           ,
                                            /*p_summ_total           => */l_amount
                                           ,
                                            /*p_summ_nal             => */0
                                           ,
                                            /*p_summ_card            => */0
                                           ,
                                            /*p_summ_sbp             => */0,0
--                                           ,
--                                            /*p_summ_avans           => */0
                                           ,
                                            /*p_summ_debt            => */0
                                           ,
                                            /*p_list_payserv_ids     => */l_payserv_id.identity
                                           ,
                                            /*p_list_payserv_qtys    => */1
                                           ,
                                            /*p_is_single_payment    => */1
                                           ,
                                            /*p_serv_check_code      => */NULL
                                           ,p_rc_real_payment_total);

      /*финализация*/
      FETCH p_rc_real_payment_total
        INTO l_payment_total_new_id;
      p_pay_2.payment_total_finalize( /*p_tmp_payment_total_id  => */l_payment_total_tmp_id.identity
                                    ,
                                     /*p_new_payment_total_ids => */l_payment_total_new_id.identity
                                    ,
                                     /* p_is_single_payment     => */1
                                    ,p_rc);
      UPDATE patserv ps
         SET payservid = l_payserv_id.identity
       WHERE ps.keyid = l_patserv_rec.keyid;

    END LOOP;

    l_result_rec.identity := l_payment_total_new_id.identity;

    IF l_stac_rnumb = 913 THEN
      /* Телемедицина/Онлайн-консультации */
      UPDATE inetuser.trueconf_info
         SET paymentid = l_result_rec.identity
       WHERE rnumbid = p_rnumb_id
         AND patientid = l_patient_id;
    END IF;

    IF l_result_rec.error_code = pkg_global.err_crit THEN
      RAISE e_error;
    ELSE
      OPEN p_rc FOR
        SELECT l_result_rec.error_code AS err_code
              ,l_result_rec.error_text AS err_text
              ,l_result_rec.identity   AS paymentid
          FROM dual;
    END IF;

  EXCEPTION
    WHEN e_error THEN
      OPEN p_rc FOR
        SELECT l_result_rec.error_code AS err_code
              ,l_result_rec.error_text AS err_text
              ,NULL                    AS paymentid
          FROM dual;
  END create_payment_by_rnumb;
  
  /**
  * Список услуг по номерку
  * Параметры:
    p_rnumb_id - Идентификатор врача
  **/
  PROCEDURE get_serv_list_by_rnumb(p_rnumb_id IN NUMBER
                                  ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    OPEN p_rc FOR
      SELECT sd.keyid
            ,sd.text
            ,nvl(pay.amount, gsp_get_price(ps.agrid, sd.keyid, gsp_date_2char(ps.dat))) AS price
        FROM rnumb r
        JOIN patserv ps ON r.visitid = ps.visitid
        JOIN srvdep sd ON ps.srvdepid = sd.keyid
        LEFT JOIN payserv pay ON ps.payservid = pay.keyid
       WHERE r.keyid = p_rnumb_id
         AND nvl(ps.visitid, 0) <> 0;
  END get_serv_list_by_rnumb;
  
  /**
  * Список СЭМДов по визиту
  * Параметры:
    p_visit_id - Идентификатор Визита
  **/
  PROCEDURE get_semd_list_by_visit(p_visit_id IN NUMBER
                                  ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    OPEN p_rc FOR
      select fr.code, fr.text, fr.dat as dat_str, fr.status, fl.link_id as semd_id
      from solution_reg.FORM_RESULT_IN fr
      , solution_data.report_files_link fl
      where fr.id = fl.link_id
      and fr.tag =1
      and fr.link_id = p_visit_id;
  END get_semd_list_by_visit;


  /**
  * Список СЭМДов по визиту
  * Параметры:
    p_doc_id - Идентификатор документа -- test 26803651
  **/
  PROCEDURE get_semd_visit(p_doc_id IN NUMBER
                          ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
  
    pkg_remd_egisz.get_all_cda_formatted_clob(p_owner => 'SOLUTION_REG',
                                              p_table => 'FORM_RESULT_IN',
                                              p_document_id => p_doc_id,
                                              p_rc => p_rc);
  END get_semd_visit;
  
  /**
  * Получение количества лабораторных заказов пациента
  * Параметр: p_patient_id - идентификатор пациента
  * p_begin_dat - начальная дата
  * p_end_dat - конечная дата
  **/
  PROCEDURE lab_orders_size(p_patient_id IN NUMBER
                              ,p_dat_from   IN DATE
                              ,p_dat_to     IN DATE
                              ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
  BEGIN
    IF p_dat_from IS NOT NULL
       OR p_dat_to IS NOT NULL THEN
    OPEN p_rc FOR
--      SELECT count(rr.orderid) AS "size"
      SELECT count(1) AS "size"
        FROM solution_lab.research rr
       WHERE rr.patient_id = p_patient_id
         AND trunc(rr.regdate) BETWEEN (p_dat_from) AND trunc(p_dat_to+1)
         and rr.root_id IS NULL;
     ELSE
    OPEN p_rc FOR
--      SELECT count(rr.orderid) AS "size"
      SELECT count(1) AS "size"
        FROM solution_lab.research rr
       WHERE rr.patient_id = p_patient_id
         and rr.root_id IS NULL;
     END IF;
  END lab_orders_size;
  
/* p_orderbyASC - сортировка 1 ASC, 0 DESC  */
-- material_id  - номер заказа
  PROCEDURE lab_orders(p_patient_id IN NUMBER
                              ,p_dat_from   IN DATE
                              ,p_dat_to     IN DATE
                              ,p_start      IN NUMBER
                              ,p_end        IN NUMBER
                              ,p_orderbyASC IN NUMBER
                              ,p_rc         IN OUT pkg_global.ref_cursor_type) AS

  BEGIN

    OPEN p_rc FOR
      SELECT * FROM (
         SELECT v.* ,rownum AS rnum
         FROM (SELECT
               CASE p_orderbyASC WHEN 1 THEN row_number() OVER (ORDER BY rr.regdate ASC)
                    ELSE row_number() OVER (ORDER BY rr.regdate DESC)
              END AS ord
            ,rr.id AS research_id
            ,rr.orderid
            ,to_char(rr.regdate, format_date_front) AS regdate
            ,CASE rr.status WHEN 'A' THEN (SELECT DECODE(COUNT(r.id), 0, 'P', 'W') FROM solution_lab.research r WHERE r.root_id = rr.id AND r.status IN ('R', 'F', '3'))
              WHEN 'I' THEN 'N'
              WHEN 'S' THEN 'N'
              WHEN 'R' THEN 'F'
              WHEN 'F' THEN 'R'
              WHEN 'X' THEN 'X'
              WHEN '1' THEN 'N'
              WHEN '2' THEN 'N'
              WHEN '3' THEN 'R'
--              WHEN '5' THEN 'N'
              WHEN '5' THEN 'R'
              ELSE rr.status
              END AS status
             ,CASE rr.status WHEN 'A' THEN (SELECT DECODE(COUNT(r.id), 0, 'в работе', 'частично выполнен') FROM solution_lab.research r WHERE r.root_id = rr.id AND r.status IN ('R', 'F', '3'))
              WHEN 'I' THEN 'ожидает обработки'
              WHEN 'S' THEN 'ожидает обработки'
              WHEN 'R' THEN 'выполнен'
              WHEN 'F' THEN 'выполнен'
              WHEN 'X' THEN 'отменён'
              WHEN '1' THEN 'ожидает обработки'
              WHEN '2' THEN 'ожидает обработки'
              WHEN '3' THEN 'выполнен'
--              WHEN '5' THEN 'ожидает обработки'
              WHEN '5' THEN 'выполнен'
              WHEN 'N' THEN 'не сдан'
              ELSE 'не определен'
              END AS text_status
           , rr.orderid AS material_id
/*
            ,r.id AS material_id
            ,r.ids
            ,(SELECT l.text
                FROM solution_lab.lu l
               WHERE l.id = r.specimen_id) AS specimen
            ,r.finishdate AS material_finishdate
            ,decode(r.status, 'I', 'N', 'S', 'N', 'A', 'P', 'F', 'R', '1', 'N', '2', 'N', '3', 'R', '5', 'N', r.status) AS material_status
            ,p_lab_report.get_research_status_for_docs(r.status) AS text_material_status
*/
        FROM /* solution_lab.research r
            , */
            solution_lab.research rr
       WHERE -- r.patient_id = p_patient_id
         rr.patient_id = p_patient_id
         and rr.root_id IS NULL
         --AND r.root_id = rr.id
         AND trunc(rr.regdate) BETWEEN trunc(p_dat_from) AND trunc(p_dat_to+1)
       ORDER BY ord) v
--       ORDER BY r.regdate DESC ,r.ids) v
                 WHERE rownum <= p_end)
         WHERE rnum >= p_start;

  END lab_orders;
  
  PROCEDURE get_lab_result(p_research_id IN NUMBER
                          ,p_rc          IN OUT pkg_global.ref_cursor_type) AS
    l_research_id NUMBER;
    l_is_root     NUMBER;
  BEGIN
    SELECT COUNT(r.id)
      INTO l_research_id
      FROM solution_lab.research r
     WHERE r.root_id = p_research_id;

    IF l_research_id > 0 THEN
      l_is_root := 1;
    ELSE
      l_is_root := 0;
    END IF;

    OPEN p_rc FOR
      SELECT --заголовок
       ri.srvtext
      ,ri.order_num
      ,ri.ids
      ,ri.id
      ,ri.specimen_text
      ,ri.regdate
       --данные "обычных" результатов
      ,trr.res_display_order_title_id AS title_id
      ,trr.title
      ,trr.res_display_order
      ,trr.measur AS test_name
      ,nvl(trr.text, trr.value) AS VALUE
      ,trr.result_note AS value_note
      ,trr.unit
      ,trr.norm
      ,trr.pat_level
      ,trr.norm_min
      ,trr.norm_max
      ,trr.norm_note
      ,trr.last_res --
      ,trr.data_last_res --
       --данные мбио
      ,mbio.abio_bactery_text
      ,mbio.abio_bactery_sortcode
      ,mbio.abio_koe
      ,mbio.res_bactery_text
      ,mbio.res_antibiotic_text
      ,mbio.res_sortcode
      ,decode(mbio.res_sir, 1, 'S', 2, 'I', 3, 'R', 'N') AS res_sir
      ,mbio.res_mic
      ,mbio.res_dia
      ,mbio.abio_conclusion --
      ,mbio.abio_note --

        FROM (SELECT r.id
                    ,listagg(fn_get_serv_name(oi.srvdep_id), ', ') within GROUP(ORDER BY r.id) AS srvtext
                    ,(SELECT text
                        FROM solution_lab.lu l
                       WHERE l.tag = 1
                         AND r.specimen_id = l.id) AS specimen_text
                    ,r.ids AS ids
                    ,r.regdate AS regdate
                    ,r.orderid AS order_num
                FROM solution_lab.research   r
                    ,solution_lab.order_info oi
               WHERE oi.research_id = r.id
                 AND ((l_is_root = 0 AND r.id = p_research_id) OR (l_is_root = 1 AND r.root_id = p_research_id))
               GROUP BY r.id
                       ,r.specimen_id
                       ,r.ids
                       ,r.orderid
                       ,r.regdate) ri

        FULL JOIN (SELECT '1' AS sortcode
                         ,dist AS dist
                         ,measur AS measur
                         ,unit AS unit
                         ,dbms_lob.substr(nvl(VALUE, ''), 4000, 1) AS VALUE
                         ,norm AS norm
                         ,pat_level
                         ,norm_min
                         ,norm_max
                         ,dbms_lob.substr(nvl(text, ''), 4000, 1) AS text
                         ,norm_note AS norm_note
                         ,result_note AS result_note
                         ,nvl(res_display_order, 0) AS res_display_order
                         ,nvl(wrv_order, 0) AS wrv_order
                         ,nvl(r_id, 0) AS r_id
                         ,nvl(title_num, 0) AS res_display_order_title_id
                         ,title AS title
                         ,dir_doctor AS dir_doctor
                         ,res_type /* тип результата: 0 - обычный, 1 - протокол */
                         ,title_note /* Примечание к материалу */
                         ,last_res
                         ,data_last_res
                     FROM ( /* Обычные результаты */
                           /*SELECT p_lab_report.get_pathology_mark_by_rv_id(rv.id) AS dist
                                  ,wr.text AS measur
                                  ,(SELECT l.text
                                      FROM solution_lab.lu l
                                     WHERE l.id = (nvl(wrv.display_unit_id, wrv.unit_id))) AS unit
                                  ,NULL AS VALUE
                                  ,rv.norm_text AS norm
                                  ,p_lab.get_pat_level_str(p_lab.get_pat_level_num(rv.value, rv.norm_id)) AS pat_level
                                  ,(SELECT to_char(n.norm_low)
                                      FROM solution_lab.norm n
                                     WHERE n.id = rv.norm_id) AS norm_min
                                  ,(SELECT to_char(n.norm_high)
                                      FROM solution_lab.norm n
                                     WHERE n.id = rv.norm_id) AS norm_max
                                  ,to_clob(p_lab_report.format_result_value(rv.value, wrv.display_format_id)) AS text
                                  ,p_lab.get_norm_note(rv.id) AS norm_note
                                  ,rv.note AS result_note
                                  ,wr.res_display_order
                                  ,wrv.display_order AS wrv_order
                                  ,wgt.num AS title_num
                                  ,wgt.text AS title
                                  ,r.id AS r_id
                                  ,p_lab_report.get_research_direct_doctor(rr.id) AS dir_doctor
                                  ,'0' AS res_type
                                  ,r.note AS title_note
                                  ,fn_last_result_value(rv.workresult_value_id, r.patient_id, r.id, 0) AS last_res
                                  ,fn_last_result_value(rv.workresult_value_id, r.patient_id, r.id, 1) AS data_last_res

                             FROM solution_lab.research               rr
                                  ,solution_lab.research               r
                                  ,solution_lab.workresult_value       wrv
                                  ,solution_lab.workresult             wr
                                  ,solution_lab.work                   w
                                  ,solution_lab.result                 res
                                  ,solution_lab.result_value           rv
                                  ,solution_lab.order_info             oi
                                  ,solution_lab.orderworkflow          owf
                                  ,solution_lab.workflow               wf
                                  ,solution_lab.workresult_group_title wgt
                            WHERE rr.id = r.root_id
                              AND r.id = oi.research_id
                              AND owf.order_id = oi.id
                              AND owf.workflow_id = wf.id
                              AND w.id = wf.work_id
                              AND wr.work_id = w.id
                              AND wrv.id = rv.workresult_value_id
                              AND res.workresult_id = wr.id
                              AND rv.result_id = res.id
                              AND rv.check_status = 1
                              AND rv.deny_print_status = 0
                              AND rv.active_status = 1
                              AND owf.id = res.orderworkflow_id
                              AND wr.res_display_order_title_id = wgt.id(+)
                              AND (nvl(wrv.hide_zero_value, 0) = 0 OR p_lab.is_zero_value(rv.value) = 0)
                              AND r.status IN ('R', 'F')
                              AND ((l_is_root = 0 AND r.id = p_research_id) OR (l_is_root = 1 AND r.root_id = p_research_id))
                           UNION ALL*/
                           /* Протокольные результаты */
                           SELECT NULL AS dist
                                  ,fi.text AS measur
                                  ,NULL AS unit
                                  ,NULL AS VALUE
                                  ,NULL AS norm
                                  ,NULL AS pat_level
                                  ,NULL AS norm_min
                                  ,NULL AS norm_max
                                  ,nvl(frv.c_text, to_clob(frv.text)) AS text
                                  ,p_lab.get_norm_note(rv.id) AS norm_note
                                  ,rv.note AS result_note
                                  ,wr.res_display_order
                                  ,fi.sortcode AS wrv_order
                                  ,wr.res_display_order AS title_num
                                  ,wr.text AS title
                                  ,r.id AS r_id
                                  ,p_lab_report.get_research_direct_doctor(rr.id) AS dir_doctor
                                  ,'1' AS res_type
                                  ,r.note AS title_note
                                  ,NULL AS last_res
                                  ,NULL AS data_last_res
                             FROM solution_lab.research          rr
                                  ,solution_lab.research          r
                                  ,solution_lab.workresult_value  wrv
                                  ,solution_lab.workresult        wr
                                  ,solution_lab.form_result_value frv
                                  ,solution_form.form_item        fi
                                  ,solution_lab.result            res
                                  ,solution_lab.result_value      rv
                                  ,solution_lab.order_info        oi
                                  ,solution_lab.orderworkflow     owf
                            WHERE r.root_id = rr.id
                              AND r.id = oi.research_id
                              AND owf.order_id = oi.id
                              AND owf.workflow_id = wrv.id
                              AND rv.workresult_value_id = wrv.id
                              AND res.workresult_id = wr.id
                              AND p_lab_utils.get_rv_form_result_id(rv.id) = frv.form_result_id
                              AND frv.form_item_id = fi.id
                              AND nvl(frv.c_text, frv.text) IS NOT NULL
                              AND rv.check_status = 1
                              AND rv.deny_print_status = 0
                              AND rv.active_status = 1
                              AND rv.result_id = res.id
                              AND owf.id = res.orderworkflow_id
                              AND r.status IN ('R', 'F') --только готовые
                              AND ((l_is_root = 0 AND r.id = p_research_id) OR (l_is_root = 1 AND r.root_id = p_research_id)))
                   UNION ALL
                   /* Внешняя лаборатория (test, test_result) и ручной ввод */
                   SELECT sortcode
                         ,dist AS dist
                         ,measur AS measur
                         ,unit AS unit
                         ,dbms_lob.substr(nvl(VALUE, ''), 4000, 1) AS VALUE
                         ,norm AS norm
                         ,pat_level
                         ,norm_min
                         ,norm_max
                         ,dbms_lob.substr(nvl(text, ''), 4000, 1) AS text
                         ,norm_note AS norm_note
                         ,result_note AS result_note
                         ,nvl(res_display_order, 0) AS res_display_order
                         ,0 AS wrv_order
                         ,nvl(r_id, 0) AS r_id
                         ,nvl(title_num, 0) AS res_display_order_title_id
                         ,title AS title
                         ,' ' AS dir_doctor
                         ,res_type
                         ,title_note
                         ,last_res
                         ,data_last_res
                     FROM (SELECT '2' AS sortcode
                                 ,tr.pathology AS dist
                                 ,m.text AS measur
                                 ,tr.unit
                                 ,to_clob(tr.result) AS VALUE
                                 ,tr.notes AS norm
                                 ,tr.pathology AS pat_level
                                 ,tr.norm_min
                                 ,tr.norm_max
                                 ,to_clob(tr.text) AS text
                                 ,NULL AS norm_note
                                 ,NULL AS result_note
                                 ,tr.notes
                                 ,t.notes AS test_notes
                                 ,tr.headermark
                                 ,nvl(tr.seqno, dense_rank() over(ORDER BY m.lcode)) AS res_display_order
                                 ,dense_rank() over(ORDER BY d.text) AS title_num
                                 ,decode(r.specimen_id
                                        ,NULL
                                        ,p_lab.get_lu_text(rr.specimen_id)
                                        ,p_lab.get_lu_text(r.specimen_id)) AS materialid
                                 ,nvl(r.id, 0) AS r_id
                                 ,r.ids
                                 ,d.text AS title
                                 ,'0' AS res_type
                                 ,r.note AS title_note
                                 ,fn_last_test_result_value(tr.id, r.patient_id, 0) AS last_res
                                 ,fn_last_test_result_value(tr.id, r.patient_id, 1) AS data_last_res
                             FROM solution_lab.test_result tr
                                 ,solution_lab.lu          m
                                 ,solution_lab.test        t
                                 ,solution_lab.lu          d
                                 ,solution_lab.research    r
                                 ,solution_lab.research    rr
                            WHERE ((l_is_root = 0 AND r.id = p_research_id) OR
                                  (l_is_root = 1 AND r.root_id = p_research_id))
                              AND t.research_id = r.id
                              AND t.description_id = d.id
                              AND tr.test_id = t.id
                              AND tr.measur_id = m.id
                              AND rr.id(+) = r.root_id
                           UNION ALL
                           /* ручной ввод (протоколы СИ-лаборатории) */
                           SELECT '3' AS sortcode
                                 ,NULL AS dist
                                 ,fi.text AS measur
                                 ,NULL AS unit
                                 ,nvl(frv.c_text, to_clob(frv.text)) AS VALUE
                                 ,NULL AS norm
                                 ,NULL AS pat_level
                                 ,'' AS norm_min
                                 ,'' AS norm_max
                                 ,nvl(frv.c_text, to_clob(frv.text)) AS text
                                 ,NULL AS norm_note
                                 ,NULL AS result_note
                                 ,NULL AS notes
                                 ,NULL test_notes
                                 ,NULL AS headermark
                                 ,fi.sortcode AS res_display_order
                                 ,fr.id AS res_display_order_title_id
                                 ,p_lab.get_lu_text(l_serv.root_id) AS materialid
                                 ,nvl(r.id, 0) AS r_id
                                 ,r.ids
                                 ,fr.text AS title
                                 ,'1' AS res_type
                                 ,r.note AS title_note
                                 ,NULL AS last_res
                                 ,NULL AS data_last_res
                             FROM solution_lab.form_result       fr
                                 ,solution_lab.form_result_value frv
                                 ,solution_form.form_item        fi
                                 ,solution_lab.order_info        oi
                                 ,solution_lab.research          r
                                 ,solution_lab.lu                l_serv
                            WHERE ((l_is_root = 0 AND r.id = p_research_id) OR
                                  (l_is_root = 1 AND r.root_id = p_research_id))
                              AND oi.research_id = r.id
                              AND fr.link_id = oi.id
                              AND frv.form_result_id = fr.id
                              AND fi.id = frv.form_item_id
                              AND oi.service_id = l_serv.id)
                    ORDER BY sortcode
                            ,res_display_order_title_id
                            ,res_display_order
                            ,wrv_order) trr
          ON (trr.r_id = ri.id)
        FULL JOIN (SELECT abio.abio_r_id AS rid
                         ,abio.*
                         ,res.*
                     FROM (SELECT DISTINCT r.id AS abio_r_id
                                          ,r.collect_place_id AS abio_collect_place_id
                                          ,oi.id AS abio_oi_id
                                          ,oi.srvdep_id AS abio_srvdep_id
                                          ,mr.id AS abio_mr_id
                                          ,mr.note AS abio_note
                                          ,mr.conclusion AS abio_conclusion
                                          ,mb1.id AS abio_mb_id
                                          ,mb1.sortcode AS abio_bactery_sortcode
                                          ,mb1.bactery_text AS abio_bactery_text
                                          ,TRIM(mb1.koe || ' ' || mb1.koe_units) AS abio_koe
                                          ,ma.antibiotic_text AS abio_antibiotic_text
                                          ,ma.sortcode AS abio_ab_sortcode
                             FROM solution_lab.research r
                             JOIN solution_lab.order_info oi
                               ON oi.research_id = r.id
                             JOIN solution_lab.mbio_result mr
                               ON mr.order_info_id = oi.id
                             LEFT JOIN solution_lab.mbio_bactery mb
                               ON mb.mbio_result_id = mr.id
                             LEFT JOIN solution_lab.mbio_antibiotic ma
                               ON ma.mbio_bactery_id = mb.id
                             LEFT JOIN solution_lab.mbio_bactery mb1
                               ON mb1.mbio_result_id = mr.id
                            WHERE ((l_is_root = 0 AND r.id = p_research_id) OR
                                  (l_is_root = 1 AND r.root_id = p_research_id))
                              AND mr.check_status = 1
                              AND (decode(ma.sir, NULL, 0, 1) >= decode(ma.dia, NULL, 0, 1) OR
                                  decode(ma.mic, NULL, 0, 1) >= decode(ma.dia, NULL, 0, 1))
                              AND nvl(mb.deny_print_status, 0) = 0
                              AND nvl(ma.deny_print_status, 0) = 0) abio

                    RIGHT JOIN

                    (SELECT DISTINCT mb.bactery_text AS res_bactery_text
                                   ,ma.antibiotic_text AS res_antibiotic_text
                                   ,ma.sortcode AS res_sortcode
                                   ,(SELECT decode(ant.deny_print_status, 1, NULL, sir)
                                       FROM solution_lab.mbio_antibiotic ant
                                           ,solution_lab.mbio_bactery    bact
                                      WHERE ant.mbio_bactery_id = bact.id
                                        AND ant.antibiotic_text = ma.antibiotic_text
                                        AND bact.id = mb.id
                                        AND ant.active_status = 1) AS res_sir
                                   ,ma.dia AS res_dia
                                   ,ma.mic res_mic
                                   ,r.id AS res_r_id
                                   ,mb.id AS res_mb_id
                      FROM solution_lab.research r
                      JOIN solution_lab.order_info oi
                        ON oi.research_id = r.id
                      JOIN solution_lab.mbio_result mr
                        ON mr.order_info_id = oi.id
                      LEFT JOIN solution_lab.mbio_bactery mb
                        ON mb.mbio_result_id = mr.id
                      LEFT JOIN solution_lab.mbio_antibiotic ma
                        ON ma.mbio_bactery_id = mb.id
                     WHERE ((l_is_root = 0 AND r.id = p_research_id) OR (l_is_root = 1 AND r.root_id = p_research_id))
                       AND mr.check_status = 1
                       AND ma.active_status = 1
                       AND (decode(ma.sir, NULL, 0, 1) >= decode(ma.dia, NULL, 0, 1) OR
                           decode(ma.mic, NULL, 0, 1) >= decode(ma.dia, NULL, 0, 1))
                       AND nvl(ma.deny_print_status, 0) = 0
                       AND nvl(mb.deny_print_status, 0) = 0) res
                       ON (res.res_r_id = abio.abio_r_id AND res.res_bactery_text = abio.abio_bactery_text)
                      AND res.res_bactery_text = abio.abio_bactery_text
                      AND res.res_antibiotic_text = abio.abio_antibiotic_text
                      AND res.res_sortcode = abio.abio_ab_sortcode
                    WHERE (abio.abio_antibiotic_text <> ' ')
                    ORDER BY abio_bactery_sortcode DESC
                            ,abio_ab_sortcode      DESC) mbio
          ON (mbio.rid = ri.id)
       ORDER BY id
               ,res_display_order;

  END get_lab_result;
  
  FUNCTION fn_last_test_result_value(p_test_res_id IN solution_lab.test_result.id%TYPE
                                    ,p_patient_id  IN solution_lab.research.patient_id%TYPE
                                    ,p_type        IN NUMBER) RETURN VARCHAR2 IS
    l_result_value VARCHAR2(4000);
    l_result_date  DATE;
  BEGIN
    SELECT DISTINCT MAX(nvl(tr1.finishdate, tr1.createdate))
                   ,tr1.text
      INTO l_result_date
          ,l_result_value
      FROM solution_lab.test_result tr
          ,solution_lab.test_result tr1
     WHERE tr.id <> tr1.id
       AND tr.id = p_test_res_id
       AND tr.test_id = tr1.test_id
       AND tr.measur_id = tr1.measur_id
       AND tr.test_id IN (SELECT t.id
                            FROM solution_lab.test t
                           WHERE t.research_id IN (SELECT r.id
                                                     FROM solution_lab.research r
                                                    WHERE r.patient_id = p_patient_id))
     GROUP BY tr1.text;

    IF p_type = 1 THEN
      RETURN l_result_date;
    ELSE
      RETURN l_result_value;
    END IF;

  END fn_last_test_result_value;
  
  /**
  * Получение данных о файле лаб. заказа
  * Параметры: p_patient_id - идентификатор пациента
  *            p_research_id  - идентификатор лаб. заказа
  **/

  /** Процедура протестирована на данных из быза заказчика Олимп Здоровья (ru360002) **/

  PROCEDURE get_lab_document_info(p_patient_id  IN NUMBER
                                 ,p_research_id IN NUMBER
                                 ,p_rc          IN OUT pkg_global.ref_cursor_type) AS

  BEGIN

    OPEN p_rc FOR
      WITH r_id AS
       (SELECT r.id
              ,r.root_id
          FROM solution_lab.research r
         WHERE r.patient_id = p_patient_id
           AND (r.root_id = p_research_id OR r.id = p_research_id))
      SELECT rd.id AS id
            ,'LAB_RESEARCH_DOCUMENT' AS file_type
            ,rd.filename AS file_name
            ,decode(rd.tag, 0, 'Бланк направления', 2, 'Бланк результатов') AS file_note
            ,nvl(rd.filetype, regexp_substr(rd.filename, '(jpg|pdf|txt|bmp|doc|xls|png)', 1, 1)) AS content_type
        FROM solution_data.lab_research_document rd
        JOIN r_id
          ON rd.research_id IN (r_id.id)
         AND rd.tag IN (0, 2)
      UNION ALL
      SELECT d.id AS id
            ,'DOCUMENTS' AS file_type
            ,d.filename AS file_name
            ,d.name AS file_note
            ,nvl(d.filetype, regexp_substr(d.filename, '(jpg|pdf|txt|bmp|doc|xls|png)', 1, 1)) AS content_type
        FROM solution_data.documents d
        JOIN v_lab_research_result vres
          ON vres.result_value_id = d.link_id
        JOIN r_id
          ON vres.research_id IN (r_id.id)
       WHERE d.tag = 9
      UNION ALL
      SELECT i.id AS id
            ,'LAB_RESULT_IMAGE' AS file_type
            ,i.full_name AS file_name
            ,'Изображение' AS file_note
            ,regexp_substr(i.full_name, '(jpg|pdf|txt|bmp|doc|xls|png)', 1, 1) AS content_type
        FROM solution_data.lab_result_image i
        JOIN v_lab_research_result vres
          ON vres.result_value_id = i.result_value_id
        JOIN r_id
          ON vres.research_id IN (r_id.id);

  END get_lab_document_info;

  /**
  * Получение файла лаб. заказа
  * Параметры: p_patient_id - идентификатор пациента
  *            p_research_id  - идентификатор лаб. заказа
               p_file_id - идентификатор файла
               p_file_type - тип фаила (в какой таблице находится
  **/

  /** Процедура протестирована на данных из быза заказчика Олимп Здоровья (ru360002) **/

  PROCEDURE get_lab_document_file(p_patient_id  IN NUMBER
                                 ,p_research_id IN NUMBER
                                 ,p_file_id     IN NUMBER
                                 ,p_file_type   IN VARCHAR2
                                 ,p_rc          IN OUT pkg_global.ref_cursor_type) AS

  BEGIN

    OPEN p_rc FOR
      WITH r_id AS
       (SELECT r.id
              ,r.root_id
          FROM solution_lab.research r
         WHERE r.patient_id = p_patient_id
           AND (r.root_id = p_research_id OR r.id = p_research_id)),
      r_file AS
       (SELECT rd.id AS id
              ,'LAB_RESEARCH_DOCUMENT' AS file_type
              ,rd.content
              ,nvl(rd.filetype, regexp_substr(rd.filename, '(jpg|pdf|txt|bmp|doc|xls|png)', 1, 1)) AS content_type
          FROM solution_data.lab_research_document rd
          JOIN r_id
            ON rd.research_id IN (r_id.id)
           AND rd.tag IN (0, 2)
        UNION ALL
        SELECT d.id AS id
              ,'DOCUMENTS' AS file_type
              ,d.content
              ,nvl(d.filetype, regexp_substr(d.filename, '(jpg|pdf|txt|bmp|doc|xls|png)', 1, 1)) AS content_type
          FROM solution_data.documents d
          JOIN v_lab_research_result vres
            ON vres.result_value_id = d.link_id
          JOIN r_id
            ON vres.research_id IN (r_id.id)
         WHERE d.tag = 9
        UNION ALL
        SELECT i.id AS id
              ,'LAB_RESULT_IMAGE' AS file_type
              ,i.image AS content
              ,regexp_substr(i.full_name, '(jpg|pdf|txt|bmp|doc|xls|png)', 1, 1) AS content_type
          FROM solution_data.lab_result_image i
          JOIN v_lab_research_result vres
            ON vres.result_value_id = i.result_value_id
          JOIN r_id
            ON vres.research_id IN (r_id.id))
      SELECT rf.content
            ,rf.content_type
        FROM r_file rf
       WHERE rf.id = p_file_id
         AND rf.file_type LIKE p_file_type;

  END get_lab_document_file;
  
  PROCEDURE get_lab_result_html (p_research_id IN NUMBER
                                   ,p_rc       IN OUT pkg_global.ref_cursor_type
                                    ) AS
  BEGIN
    get_lab_research_info(p_research_id, 1);
    pkg_html.get_tmp_html(null, p_rc);

  END get_lab_result_html;
  
  /*==========================================================================*/
  /* Информация по всему заказу копия p_hist_html.get_lab_research_info*/
  /*==========================================================================*/
  PROCEDURE get_lab_research_info(p_research_id IN NUMBER
                                 ,p_erase       IN NUMBER) AS
    l_v_research_rec solution_lab.v_research%ROWTYPE;
    l_direct_str     VARCHAR2(1000);
  BEGIN
    IF p_erase = 1 THEN
      pkg_html.truncate_tmp_html();
      pkg_html.w_style('verdana', 10);
/*
      w('<html>');
      w_head();
      w_style();
      w('<body>');
*/
    END IF;

    SELECT v.*
      INTO l_v_research_rec
      FROM solution_lab.v_research v
     WHERE v.id = p_research_id;

    SELECT (CASE
             WHEN l_v_research_rec.external_customer != ' '
                  AND l_v_research_rec.external_doc != ' ' THEN
              l_v_research_rec.external_doc || ' (' || l_v_research_rec.external_customer || ')'
             WHEN l_v_research_rec.external_customer IS NOT NULL
                  AND l_v_research_rec.external_doc IS NULL THEN
              l_v_research_rec.external_customer
             WHEN l_v_research_rec.internal_customer IS NOT NULL
                  AND l_v_research_rec.internal_doc IS NOT NULL THEN
              l_v_research_rec.internal_doc || ' (' || l_v_research_rec.internal_customer || ')'
             WHEN l_v_research_rec.internal_customer IS NOT NULL
                  AND l_v_research_rec.internal_doc IS NULL THEN
              l_v_research_rec.internal_customer
             WHEN l_v_research_rec.docdep_direct_doctor IS NOT NULL THEN
              l_v_research_rec.docdep_direct_doctor
             WHEN l_v_research_rec.lu_direct_doctor IS NOT NULL THEN
              l_v_research_rec.lu_direct_doctor
           END)
      INTO l_direct_str
      FROM dual;

/*
    --  Регистрационная информация
    pkg_html.w('<table width="100%" bgcolor=#000000 cellspacing=1 cellpadding=5><tr><td bgcolor=#FFFFCC>');
    pkg_html.w_h('<font color=#006600>' || to_char(l_v_research_rec.regdate, 'dd.mm.yyyy') || ' : </font>' ||
        'ЛАБОРАТОРНЫЕ ИССЛЕДОВАНИЯ'
       ,'#CC0000');
    pkg_html.w('</td></tr></table>');
*/
    pkg_html.w('<div style="margin-left:20">');

    pkg_html.w('<br>');
    pkg_html.w('<table cellspacing=0 cellpadding=1>');


    IF l_direct_str IS NOT NULL THEN
      pkg_html.w_row('Направил:', l_direct_str);
    END IF;

    pkg_html.w('</table>');
    pkg_html.w('<br>');

    FOR res IN (SELECT 0 AS sortcode
                      ,r.id AS research_id
                      ,(SELECT decode(COUNT(1), 0, 0, 1)
                          FROM solution_lab.test t
                         WHERE t.research_id = r.id) AS ext_results
                      ,CASE
                         WHEN length(rtrim(r.status, '01235')) > 0 THEN
                          1
                         ELSE
                          0
                       END AS internal_order
                  FROM solution_lab.research r
                 WHERE r.id = l_v_research_rec.id
                   AND r.root_id IS NOT NULL
                UNION ALL
                SELECT 1 AS sortcode
                      ,r.id AS research_id
                      ,(SELECT decode(COUNT(1), 0, 0, 1)
                          FROM solution_lab.test t
                         WHERE t.research_id = r.id) AS ext_results
                      ,CASE
                         WHEN length(rtrim(r.status, '01235')) > 0 THEN
                          1
                         ELSE
                          0
                       END AS internal_order
                  FROM solution_lab.research r
                 WHERE r.root_id = l_v_research_rec.id
                 ORDER BY sortcode
                         ,research_id)
    LOOP
      IF res.ext_results = 0
         AND res.internal_order = 0 THEN
        CONTINUE;
      END IF;

      IF res.ext_results = 1 THEN
        p_hist_html.get_lab_child_research_info_e(res.research_id, 1 - res.internal_order);
      END IF;

      IF res.internal_order = 1 THEN
        p_hist_html.get_lab_child_research_info(res.research_id, 1 - res.ext_results);
      END IF;
      pkg_html.w('</br>');
    END LOOP;

    IF l_v_research_rec.narrative IS NOT NULL THEN
      pkg_html.w('<br>');
      pkg_html.w('<table cellspacing=0 cellpadding=1>');
      pkg_html.w_row('Заключение :', l_v_research_rec.narrative);
      pkg_html.w('</table>');
    END IF;

    pkg_html.w('</div>');

    pkg_html.w('</br>');
/*
    IF p_erase = 1 THEN
      pkg_html.w('</body>');
      pkg_html.w('</html>');
    END IF;
*/
  EXCEPTION
    WHEN no_data_found THEN
      NULL;

  END get_lab_research_info;
  

/*****************************************/
/*   Количество ЛАБ анализов по пациенту */
/*****************************************/
  PROCEDURE get_lab_list_size(p_patient_id IN NUMBER
                              ,p_begin_dat  IN VARCHAR2
                              ,p_end_dat    IN VARCHAR2
                              ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
  l_begin_dat DATE;
  l_end_dat   DATE;
  BEGIN
    l_begin_dat := to_date(p_begin_dat, format_date_in);
    l_end_dat := to_date(p_end_dat, format_date_in);

    OPEN p_rc FOR
      SELECT count(*) AS "size"
      FROM (select r.id
                FROM solution_lab.research   r
                    ,solution_lab.order_info oi
               WHERE oi.research_id = r.id
               and r.patient_id = 1925388 -- p_patient_id
               and r.root_id IS not NULL
               and trunc(r.regdate) BETWEEN trunc(l_begin_dat) AND trunc(l_end_dat+1)
               GROUP BY r.id
                       ,r.specimen_id
                       ,r.ids
                       ,r.orderid
                       ,r.regdate) v;
  END get_lab_list_size;
  
/************************************/
/*  Список ЛАБ анализов по пациенту */
/************************************/
  
  PROCEDURE get_lab_list(p_patient_id IN NUMBER
                              ,p_begin_dat   IN VARCHAR2
                              ,p_end_dat     IN VARCHAR2
                              ,p_start      IN NUMBER
                              ,p_end        IN NUMBER
                              ,p_rc         IN OUT pkg_global.ref_cursor_type) AS
                              
  l_begin_dat DATE;
  l_end_dat   DATE;
  BEGIN
    l_begin_dat := to_date(p_begin_dat, format_date_in);
    l_end_dat := to_date(p_end_dat, format_date_in);

    OPEN p_rc FOR
      SELECT v.*
      FROM (
      select ri.* ,rownum AS rnum
              FROM (SELECT r.id as research_id
                          ,listagg(fn_get_serv_name(oi.srvdep_id), ', ') within GROUP(ORDER BY r.id) AS srvtext
                          ,(SELECT text
                              FROM solution_lab.lu l
                             WHERE l.tag = 1
                               AND r.specimen_id = l.id) AS specimen_text
                          ,r.ids AS ids
                          ,r.regdate AS regdate
                          ,to_char(r.regdate, format_date_front) AS regdate_str
                          ,r.orderid AS order_num
                      FROM solution_lab.research   r
                          ,solution_lab.order_info oi
                     WHERE oi.research_id = r.id
                     and r.patient_id = p_patient_id
                     and r.root_id IS not NULL
                     and trunc(r.regdate) BETWEEN trunc(l_begin_dat) AND trunc(l_end_dat+1)
                     GROUP BY r.id
                             ,r.specimen_id
                             ,r.ids
                             ,r.orderid
                             ,r.regdate) ri
      Order by ri.regdate desc) v
                       WHERE rnum BETWEEN p_start AND p_end ;
  END get_lab_list;
  
  PROCEDURE count_research_patient (p_patient_id  IN NUMBER
                                   ,p_research_id IN NUMBER
                                   ,p_rc       IN OUT pkg_global.ref_cursor_type
                                    ) AS
     l_col  number;
  BEGIN
    select count(r.id) as col
    into l_col
    from solution_lab.research r
    where (root_id = p_research_id or (id = p_research_id and root_id is not null))
    -- and status in ('R', 'F','3')
    and r.patient_id = p_patient_id;

    OPEN p_rc FOR
      SELECT p.num -- Номер карты в ЛПУ
            ,g_make_first_upper(p.lastname) AS lastname -- Фамилия
            ,g_make_first_upper(p.firstname) AS firstname -- Имя
            ,g_make_first_upper(p.secondname) AS secondname -- Отчество
            ,to_char(p.birthdate, 'dd.mm.yyyy') AS birthdateStr
            ,p.phone -- Номер телефона
            ,p.cellular -- Номер сотового телефона
            ,p.note AS email -- e-mail/факс
            ,p.snils   -- снилс ИНН
            ,gsp_get_pat_address(p.keyid, 2) AS address_proj -- Адрес проживания
            ,(SELECT count(PL.ID) FROM inetuser.patient_logon pl
                 WHERE pl.status = 1
                       AND pl.patient_id = p_patient_id
                       AND pl.logon_name IS NOT NULL
                       AND pl.pass  IS NOT NULL)  AS count_login
             ,p.sex
             , gsp_get_age_full_years(p.birthdate, SYSDATE) as age
             , l_col as col
        FROM patient p
       WHERE p.keyid = p_patient_id;
  END count_research_patient;


  /**
  * Список СЭМДов по Пациенту
  * Параметры:
    p_visit_id - Идентификатор Визита
  **/
  PROCEDURE get_semd_list_by_patient(p_patient_id IN NUMBER
                                    ,p_begin_dat   IN VARCHAR2
                                    ,p_end_dat     IN VARCHAR2
                                    ,p_start      IN NUMBER
                                    ,p_end        IN NUMBER
                                    ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
  l_begin_dat DATE;
  l_end_dat   DATE;
  BEGIN
    l_begin_dat := to_date(p_begin_dat, format_date_in);
    l_end_dat := to_date(p_end_dat, format_date_in);
  
    OPEN p_rc FOR
      select fr.code, fr.text,
       to_char(fr.dat, format_date_front) AS dat_str,
       fr.status, fl.link_id as semd_id
      from solution_reg.FORM_RESULT_IN fr
      , solution_data.report_files_link fl
      where fr.id = fl.link_id
      and fr.tag =1
      and trunc(fr.dat) BETWEEN trunc(l_begin_dat) AND trunc(l_end_dat)
      and fr.link_id in (select v.keyid FROM visit v where v.patientid = p_patient_id)
      Order by  fr.dat;
  END get_semd_list_by_patient;
                  
  /**
  * Список СЭМДов по Пациенту
  * Параметры:
    p_visit_id - Идентификатор Визита
  **/
  PROCEDURE get_semd_size_by_patient(p_patient_id IN NUMBER
                                    ,p_begin_dat   IN VARCHAR2
                                    ,p_end_dat     IN VARCHAR2
                                    ,p_rc       IN OUT pkg_global.ref_cursor_type) AS
  l_begin_dat DATE;
  l_end_dat   DATE;
  BEGIN
    l_begin_dat := to_date(p_begin_dat, format_date_in);
    l_end_dat := to_date(p_end_dat, format_date_in);
  
    OPEN p_rc FOR
      SELECT count(*) AS "size"
      from solution_reg.FORM_RESULT_IN fr
      , solution_data.report_files_link fl
      where fr.id = fl.link_id
      and fr.tag =1
      and trunc(fr.dat) BETWEEN trunc(l_begin_dat) AND trunc(l_end_dat)
      and fr.link_id in (select v.keyid FROM visit v where v.patientid = p_patient_id)
      Order by  fr.dat;
  END get_semd_size_by_patient;

              
                              
                              
END pkg_web_account_unique_7;
